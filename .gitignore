# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# backend runtime logs (regenerated each run)
backend/*.log

# Dev server stdout/stderr redirected to files (regenerated each `npm run dev`)
/fleet360-dev.out.log
/fleet360-dev.err.log

# Debug API response dumps (regenerated by ad-hoc curl scripts)
backend/response*.json
backend/response_*.json

# Go build artifacts
backend/*.exe
backend/cmd/*/*.exe
# Also catch scripts/, tools/, etc. under backend/ — any compiled Go
# binary anywhere in the backend tree is a build artefact.
backend/**/*.exe

# Go build cache (huge, regenerates on every build)
/.cache/

# env files (can opt-in for committing if needed)
.env*
# .env.example is the documented template — safe to commit (no real secrets)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
# Per-project incremental TS compile info (e.g. .tsbuildinfo.finance) —
# same cache as *.tsbuildinfo but with a project suffix, never committed.
/.tsbuildinfo.*
next-env.d.ts

# ── Local dev/build stdout+stderr — regenerated on every run ──────────────
# Broad *.log / *.err / *.out are safe here: no such files are tracked in
# the repo, and dev tooling routinely dumps output like admin-build.err,
# dev-capture.log, cap-sync.out, all-unit.log, clean-dev-*.log next to the
# project root. Keeping them out of git status noise makes real dirty
# state visible.
*.log
*.err
*.out
/.build-output.txt
/.prisma-gen.txt
/.tsc-output.txt
/check-out*.txt
# Harness CI local scratch dir
/.harness/

/src/generated/prisma

# Claude Code session state and worktrees
/.claude/

# Test artifacts
/playwright-report
/test-results

# Uploaded customer files (handled by storage adapter, not version control)
/public/uploads

# Accidental terminal-redirect outputs (0-byte files)
/npm
/p.$disconnect())
/template-c1@0.1.0
/playwright
/npx
/$p

# Local dev / diagnostics scratch (never commit)
/jdk*.zip
/netstat.txt
/final-prebuild.txt
/prebuild-fail.txt
/scripts/screen-*.png
/scripts/sdk-installed.txt

