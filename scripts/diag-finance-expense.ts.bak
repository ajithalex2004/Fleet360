// Quick diagnostic: can we create a FinanceExpense via Prisma?
import { PrismaClient } from '@prisma/client';
const p = new PrismaClient();

try {
  const count = await p.financeExpense.count();
  console.log('financeExpense.count =', count);
} catch (e) {
  console.error('financeExpense error:', e.message);
}

try {
  const r = await p.$queryRaw`SELECT count(*)::int AS n FROM finance.finance_expenses`;
  console.log('raw count =', r);
} catch (e) {
  console.error('raw error:', e.message);
}

// Try a direct create
try {
  const id = crypto.randomUUID();
  const exp = await p.financeExpense.create({
    data: {
      id,
      expenseNo: `DIAG-${Date.now()}`,
      category: 'FUEL',
      description: 'diag test',
      amount: 50.0,
      currency: 'AED',
      totalAmount: 50.0,
      expenseDate: new Date(),
      tenantId: 'diag-tenant-' + Date.now(),
      referenceNo: 'diag-ref-' + id,
    },
  });
  console.log('create OK, id =', exp.id);
  // Cleanup
  await p.financeExpense.delete({ where: { id } });
  console.log('cleanup OK');
} catch (e) {
  console.error('create error:', e.message);
  console.error('  code:', e.code);
  console.error('  meta:', JSON.stringify(e.meta));
}

await p.$disconnect();
