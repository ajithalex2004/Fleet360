#!/usr/bin/env bash
#
# Pre-commit hook: Check tenant RLS compliance for modified API routes
#
# To install: npm run setup-hooks
# To bypass: git commit --no-verify

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get list of staged API route files
STAGED_API_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^src/app/api/.*\.ts$' || true)

if [ -z "$STAGED_API_FILES" ]; then
  # No API routes modified, skip check
  exit 0
fi

echo -e "${YELLOW}🔍 Checking tenant RLS compliance for modified API routes...${NC}"
echo ""

# Create temp file for staged routes
TEMP_FILE=$(mktemp)
echo "$STAGED_API_FILES" > "$TEMP_FILE"

# Run compliance check
if node scripts/check-tenant-rls.js --files="$TEMP_FILE" > /dev/null 2>&1; then
  echo -e "${GREEN}✅ All staged API routes pass tenant RLS compliance checks${NC}"
  rm "$TEMP_FILE"
  exit 0
else
  # Get detailed report
  REPORT=$(node scripts/check-tenant-rls.js --files="$TEMP_FILE" 2>&1 || true)

  # Count violations in staged files
  VIOLATIONS=$(echo "$REPORT" | grep "^❌ src/app/api/" | wc -l | tr -d ' ')

  if [ "$VIOLATIONS" -gt 0 ]; then
    echo -e "${RED}❌ Tenant RLS compliance check failed!${NC}"
    echo ""
    echo -e "${RED}Found $VIOLATIONS violation(s) in staged files:${NC}"
    echo ""

    # Show violations for staged files only
    echo "$REPORT" | grep -A 2 "^❌ src/app/api/" | head -20

    echo ""
    echo -e "${YELLOW}How to fix:${NC}"
    echo "  1. Add requireAuthorizedTenant() at handler start"
    echo "  2. Wrap database ops with withTenantRls(prisma, tenantId, async (tx) => {...})"
    echo "  3. Sanitize request bodies with stripTenantOwnershipFields()"
    echo ""
    echo -e "${YELLOW}Run full check:${NC} npm run tenant:check-rls"
    echo -e "${YELLOW}To bypass (not recommended):${NC} git commit --no-verify"
    echo ""

    rm "$TEMP_FILE"
    exit 1
  fi

  rm "$TEMP_FILE"
  exit 0
fi
