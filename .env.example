# =============================================================================
# XL AI Smart Mobility Platform — Environment Variables
# =============================================================================
# Copy this file to .env (development) or set these as deployment env vars
# in production. The .env file is gitignored. Validate via: import { env } from '@/lib/env'
# =============================================================================

# ── DATABASE (REQUIRED) ──────────────────────────────────────────────────────
# Production: managed Postgres (Neon / RDS / Supabase). Use a connection-pooler URL for app runtime.
# Local dev:  postgresql://postgres:postgres@localhost:5432/mobility_dev
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15&pool_timeout=30&connection_limit=5&pgbouncer=true

# Direct database URL for migrations/schema tools. Keep runtime traffic on DATABASE_URL above.
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15

# DB resilience knobs. Keep connect timeout short enough that pages fail fast
# with a clear 503 instead of hanging indefinitely.
DB_CONNECT_TIMEOUT_MS=5000
DB_CONNECT_RETRIES=3
DB_OPERATION_RETRIES=2
DB_KEEPALIVE_INTERVAL_MS=45000
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_IDLE_SECONDS=60
DB_CONN_MAX_LIFETIME_SECONDS=300

# Optional: separate URL for direct local DB access (skips pooler).
# LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mobility_dev

# ── GO BACKEND (required for migrated logistics/RFQ actions) ─────────────────
# Next.js proxies migrated /api/logistics/* calls to this Go /api/v1 backend.
GO_BACKEND_URL=http://localhost:8080
# Required before running backend seed commands. Production refuses demo seeding.
GO_ENV=development
# Optional: target a specific tenant when running `go run . seed-marketplace`.
# If omitted, the seed command uses the first active tenant.
MARKETPLACE_SEED_TENANT_ID=

# ── SESSION (REQUIRED in production) ─────────────────────────────────────────
# HMAC-SHA256 secret used to sign xl-session cookies. Min 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-min-32-chars-random-secret-for-prod

# ── APPLICATION URL (REQUIRED) ───────────────────────────────────────────────
# Used in email links, approval URLs, and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── AI / GENUI (REQUIRED for STS AI features) ────────────────────────────────
# OpenAI: powers Quotation Co-pilot, Document Auto-Classification, Contract Q&A.
OPENAI_API_KEY=sk-...

# Thesys C1: powers the generative-UI chat features.
THESYS_API_KEY=your-thesys-key

# ── EMAIL (one of these blocks required for dunning, alerts, notifications) ──
# Option A — SMTP (Mailgun, SendGrid SMTP, AWS SES SMTP, Office365):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false                 # true only for port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="XL AI Smart Mobility <noreply@your-domain.com>"
EMAIL_FROM="XL AI Smart Mobility <noreply@your-domain.com>"

# Option B — SendGrid HTTP API (alternative to SMTP):
# SENDGRID_API_KEY=

# ── WHATSAPP / TWILIO (optional — for STS notifications) ─────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── MAPS (optional — for tracking views, route optimizer) ────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=
# Google Maps Embed API key for the Control Tower route map (client-exposed —
# use a key restricted to the Maps Embed API + your domains by HTTP referrer).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# ── OPERATIONS ESCALATION (optional) ─────────────────────────────────────────
OPERATIONS_PHONE=
OPERATIONS_EMAIL=

# ── ADMIN BOOTSTRAP (REQUIRED to use /api/setup/super-admin) ─────────────────
# Random shared secret protecting the bootstrap endpoint. Used only at install.
SETUP_SECRET=change-me-random-secret

# ── ERROR TRACKING (optional but strongly recommended for production) ────────
# Get from https://sentry.io/ — leave blank to disable Sentry without errors.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ── ENVIRONMENT FLAG ─────────────────────────────────────────────────────────
# Set automatically by Next.js / Vercel. Override only if needed.
# NODE_ENV=development
