# =============================================================================
# XL AI Smart Mobility Platform — Environment Variables
# =============================================================================
# Copy this file to .env (development) or set these as deployment env vars
# in production. The .env file is gitignored. Validate via: import { env } from '@/lib/env'
# =============================================================================

# ── DATABASE (REQUIRED) ──────────────────────────────────────────────────────
# Production: managed Postgres (Neon / RDS / Supabase). Use a connection-pooler URL for app runtime.
# Local dev:  postgresql://postgres:postgres@localhost:5432/mobility_dev
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15&pool_timeout=30&connection_limit=5&pgbouncer=true

# Direct database URL for migrations/schema tools. Keep runtime traffic on DATABASE_URL above.
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15

# DB resilience knobs. Keep connect timeout short enough that pages fail fast
# with a clear 503 instead of hanging indefinitely.
DB_CONNECT_TIMEOUT_MS=5000
DB_CONNECT_RETRIES=3
DB_OPERATION_RETRIES=2
DB_KEEPALIVE_INTERVAL_MS=45000
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_IDLE_SECONDS=60
DB_CONN_MAX_LIFETIME_SECONDS=300

# ── DATA RESIDENCY ───────────────────────────────────────────────────────────
# Regions whose residency promise THIS deployment satisfies, i.e. where its
# DATABASE_URL lives (comma-separated: EU, UAE, US). GLOBAL is always served.
# Tenants whose data_residency is not listed are refused (HTTP 503) and new
# ENTERPRISE tenants cannot be provisioned into an unlisted region: the app
# fails closed instead of storing their data in the wrong region.
# DATABASE_URL_EU / _UAE / _US alone do NOT make a region servable; route
# handlers use DATABASE_URL. Serve a region from an in-region deployment.
# DATA_RESIDENCY_SERVED_REGIONS=

# Directory for uploaded files (default: public/uploads, where older releases
# wrote). Files are only ever served through /api/files, which authorizes each
# request against the file's owning record; prefer a path outside public/ on a
# persistent volume. See docs/security/UPLOADS_EXPOSURE_ASSESSMENT.md.
# FILE_STORAGE_DIR=/data/uploads

# Private object storage for uploads (recommended in production). Any
# S3-compatible store: AWS S3 (UAE region me-central-1), Cloudflare R2, MinIO.
# The bucket must not be public; files are still served only through
# /api/files after the per-record check. Copy existing local files across with
#   node scripts/migrate-uploads-to-s3.mjs --dry-run   then without --dry-run
# STORAGE_BACKEND=s3
# S3_ENDPOINT=                 # empty for AWS; e.g. <account>.r2.cloudflarestorage.com or minio:9000
# S3_REGION=me-central-1       # "auto" for Cloudflare R2
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=fleet360-documents
# S3_KEY_PREFIX=               # optional folder inside the bucket
# S3_USE_SSL=true              # false only for local MinIO over plain HTTP
# S3_FORCE_PATH_STYLE=         # defaults to true for non-AWS endpoints

# Optional: separate URL for direct local DB access (skips pooler).
# LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mobility_dev

# ── GO BACKEND (required for migrated logistics/RFQ actions) ─────────────────
# Next.js proxies migrated /api/logistics/* calls to this Go /api/v1 backend.
GO_BACKEND_URL=http://localhost:8080
# Required before running backend seed commands. Production refuses demo seeding.
GO_ENV=development
# Optional: target a specific tenant when running `go run . seed-marketplace`.
# If omitted, the seed command uses the first active tenant.
MARKETPLACE_SEED_TENANT_ID=

# ── SESSION (REQUIRED in production) ─────────────────────────────────────────
# HMAC-SHA256 secret used to sign xl-session cookies. Min 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-min-32-chars-random-secret-for-prod

# ── APPLICATION URL (REQUIRED) ───────────────────────────────────────────────
# Used in email links, approval URLs, and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── AI / GENUI (REQUIRED for STS AI features) ────────────────────────────────
# OpenAI: powers Quotation Co-pilot, Document Auto-Classification, Contract Q&A.
OPENAI_API_KEY=sk-...

# Thesys C1: powers the generative-UI chat features.
THESYS_API_KEY=your-thesys-key

# ── EMAIL (one of these blocks required for dunning, alerts, notifications) ──
# Option A — SMTP (Mailgun, SendGrid SMTP, AWS SES SMTP, Office365):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false                 # true only for port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="XL AI Smart Mobility <noreply@your-domain.com>"
EMAIL_FROM="XL AI Smart Mobility <noreply@your-domain.com>"

# Option B — SendGrid HTTP API (alternative to SMTP):
# SENDGRID_API_KEY=

# ── WHATSAPP / TWILIO (optional — for STS notifications) ─────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── MAPS (optional — for tracking views, route optimizer) ────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=
# Google Maps Embed API key for the Control Tower route map (client-exposed —
# use a key restricted to the Maps Embed API + your domains by HTTP referrer).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# ── GOOGLE CLOUD ROUTE OPTIMIZATION (optional — bus-ops Route Planner "Optimize
#    Stops" and Fleet Routing plan-time optimizer) ────────────────────────────
# Service account with the "Cloud Optimization AI Editor" role, scoped to the
# project below. Enable the Route Optimization API and Routes API on the
# project first, then create the SA, download its JSON key, and base64-encode
# it:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
# Without these set, the optimizer falls back to a mock (zeroed) result and
# surfaces a "Google Cloud not configured" warning in the UI instead of failing.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_SA_KEY=

# ── OPERATIONS ESCALATION (optional) ─────────────────────────────────────────
OPERATIONS_PHONE=
OPERATIONS_EMAIL=

# ── ADMIN BOOTSTRAP (REQUIRED to use /api/setup/super-admin) ─────────────────
# Random shared secret protecting the bootstrap endpoint. Used only at install.
SETUP_SECRET=change-me-random-secret

# ── CRON / SCHEDULER SECRETS (REQUIRED in production) ────────────────────────
# Shared secrets for the endpoints an external scheduler calls. Send as
#   Authorization: Bearer <secret>
#
# These are NOT optional in production. The routes fail closed when unset —
# POST /api/push/run-scheduler returns 503 rather than running unauthenticated,
# because a call with no tenant fans push notifications out to EVERY tenant.
# Outside production an unset secret is allowed so local work needs no setup.
PUSH_CRON_SECRET=
CRON_SECRET=

# Optional: per-tenant transaction budget (ms) for the dunning sweep. Each
# tenant's open invoices are processed in one transaction; default 120000.
# DUNNING_SWEEP_TENANT_TIMEOUT_MS=120000

# ── ERROR TRACKING (optional but strongly recommended for production) ────────
# Get from https://sentry.io/ — leave blank to disable Sentry without errors.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ── ENVIRONMENT FLAG ─────────────────────────────────────────────────────────
# Set automatically by Next.js / Vercel. Override only if needed.
# NODE_ENV=development
