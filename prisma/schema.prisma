  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(14, 2)
  allocationDate  DateTime @default(now()) @map("allocation_date") @db.Date

  notes       String?
  allocatedBy String? @map("allocated_by")
  tenantId    String? @map("tenant_id")

  @@unique([paymentId, invoiceId], map: "uq_alloc_payment_invoice")
  @@unique([paymentId, payableId], map: "uq_alloc_payment_payable")
  @@index([paymentId], map: "idx_payment_alloc_payment")
  @@index([invoiceId], map: "idx_payment_alloc_invoice")
  @@index([payableId], map: "idx_payment_alloc_payable")
  @@index([tenantId], map: "idx_payment_alloc_tenant")
  @@map("finance_payment_allocations")
  @@schema("finance")
}

