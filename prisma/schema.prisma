/// Breakdown report — first step in the Breakdown Maintenance flow.
///
/// Flow: Driver reports breakdown → BreakdownReport created → MaintenanceRequest
/// auto-created (type=BREAKDOWN, priority=HIGH) → recovery dispatched → vehicle
/// arrives at workshop → MR continues through normal repair workflow.
///
/// The MR is intentionally bypass the estimation/quotation steps.
model BreakdownReport {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  reportNo   String?  @map("report_no") // BRK-YYYYMM-NNNNN
  tenantId   String   @map("tenant_id")
  vehicleId  String?  @map("vehicle_id")
  driverId   String?  @map("driver_id")
  reportedAt DateTime @default(now()) @map("reported_at") @db.Timestamptz(6)

  /// FLAT_TYRE | ENGINE_FAILURE | BATTERY_DEAD | ACCIDENT | FUEL_EMPTY |
  /// OVERHEATING | ELECTRICAL | TRANSMISSION | OTHER
  breakdownType String @default("OTHER") @map("breakdown_type")

  /// FREE TEXT location description (e.g. "Sheikh Zayed Road, near Mall of UAE")
  location  String?
  latitude  Decimal? @db.Decimal
  longitude Decimal? @db.Decimal

  driverNotes String? @map("driver_notes")
  photoUrls   Json?   @default("[]") @map("photo_urls")

  severity String @default("HIGH")
  // REPORTED | RECOVERY_DISPATCHED | RECOVERY_COMPLETED | AT_WORKSHOP | RESOLVED
  status   String @default("REPORTED")

  /// Recovery dispatch details
  recoveryVehicleId    String?   @map("recovery_vehicle_id")
  recoveryDriverId     String?   @map("recovery_driver_id")
  recoveryNotes        String?   @map("recovery_notes")
  recoveryDispatchedAt DateTime? @map("recovery_dispatched_at") @db.Timestamptz(6)
  recoveryCompletedAt  DateTime? @map("recovery_completed_at") @db.Timestamptz(6)
  estimatedArrivalAt   DateTime? @map("estimated_arrival_at") @db.Timestamptz(6)

  /// Auto-created MaintenanceRequest when this breakdown report is submitted
  maintenanceRequestId String?             @unique @map("maintenance_request_id")
  MaintenanceRequest   MaintenanceRequest? @relation("breakdown_mr", fields: [maintenanceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, status], map: "idx_breakdown_reports_tenant_status")
  @@index([vehicleId], map: "idx_breakdown_reports_vehicle_id")
  @@index([reportedAt], map: "idx_breakdown_reports_reported_at")
  @@index([deletedAt], map: "idx_breakdown_reports_deleted_at")
  @@map("breakdown_reports")
  @@schema("public")
  @@unique([tenantId, reportNo])
}

