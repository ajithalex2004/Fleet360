model Vehicle {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId  String    @map("tenant_id")

  // -- Identity (Fleet Hub core fields) ---------------------------------------
  make         String?
  model        String?
  type         String?
  year         BigInt?
  licensePlate String? @unique(map: "idx_vehicles_license_plate") @map("license_plate")
  vin          String? @unique(map: "idx_vehicles_vin")
  color        String?
  fuelType     String? @map("fuel_type")

  // -- Classification -------------------------------------------------------
  vehicleUsage    String? @map("vehicle_usage") // RENTAL|STAFF|SCHOOL_BUS|LOGISTICS|AMBULANCE|POOL|EXECUTIVE
  vehicleGroup    String? @map("vehicle_group") // ECONOMY|LUXURY|BUS|VAN|PICKUP|SUV...
  vehicleClass    String? @map("vehicle_class") // COMPACT|MID_SIZE|FULL_SIZE...
  seatingCapacity Int?    @map("seating_capacity")

  // -- Operational ----------------------------------------------------------
  status          String? // AVAILABLE|RENTED|MAINTENANCE|RESERVED|INACTIVE|SOLD
  isActive        Boolean? @default(true) @map("is_active")
  currentMileage  BigInt?  @map("current_mileage")
  odometerReading BigInt?  @map("odometer_reading")
  fuelLevel       Float?   @map("fuel_level")

  // -- Home depot (Phase 3b addition) ---------------------------------------
  // Optional FK to spatial.places(id) — the depot the vehicle returns to at
  // end-of-day. App layer is responsible for ensuring the referenced Place
  // has type=DEPOT; the FK itself is untyped so a depot can graduate to a
  // multi-use site without an ALTER.
  homeDepotId String? @map("home_depot_id")
  homeDepot   Place?  @relation("VehicleHomeDepot", fields: [homeDepotId], references: [id], onDelete: SetNull)

  // Optional FK to spatial.places(id) with type=OPERATIONAL_ZONE — the
  // broad zone this vehicle is based in. Used as a soft ranking signal by
  // Planning Core's smart vehicle matching (lib/plan/assign-vehicles.ts):
  // same-zone vehicles rank above cross-zone ones, but zone is never a
  // hard eligibility filter — an untagged vehicle is still assignable,
  // just not zone-preferred.
  zoneId String? @map("zone_id")
  zone   Place?  @relation("VehicleZone", fields: [zoneId], references: [id], onDelete: SetNull)

  // -- Fleet extended fields (used by Fleet raw-SQL queries) ----------------
  vehicleCode     String?   @map("vehicle_code")
  vehicleTypeId   String?   @map("vehicle_type_id")
  lifecycleStage  String?   @map("lifecycle_stage") // ACTIVE|ALLOCATED|DECOMMISSIONED|SOLD
  acquisitionType String?   @map("acquisition_type") // PURCHASED|LEASED|RENTED
  purchaseDate    DateTime? @map("purchase_date") @db.Timestamptz(6)
  purchasePrice   Decimal?  @map("purchase_price")
  emirate         String? // Dubai|Abu Dhabi|Sharjah...
  plateNumber     String?   @map("plate_number")
  plateCode       String?   @map("plate_code")
  plateCategory   String?   @map("plate_category")
  registrationNo  String?   @map("registration_no")
  chassisNo       String?   @map("chassis_no")
  hierarchyId     String?   @map("hierarchy_id")
  hierarchyName   String?   @map("hierarchy_name")
  branchId        String?   @map("branch_id")
  branchName      String?   @map("branch_name")
  deviceId        String?   @map("device_id")
  simCardNo       String?   @map("sim_card_no")
  category        String?
  notes           String?

  // -- Compliance -----------------------------------------------------------
  registrationExpiry DateTime? @map("registration_expiry") @db.Timestamptz(6)
  insuranceExpiry    DateTime? @map("insurance_expiry") @db.Timestamptz(6)
  mulkiyaExpiry      DateTime? @map("mulkiya_expiry") @db.Timestamptz(6)

  // -- Ownership / assignment ------------------------------------------------
  assignedDriverId String? @map("assigned_driver_id")
  garageId         String? @map("garage_id")

  // -- Relations ------------------------------------------------------------
  maintenanceRequests MaintenanceRequest[]
  drivers             Driver[]
  serviceSchedules    ServiceSchedule[]

  @@index([deletedAt], map: "idx_vehicles_deleted_at")
  @@index([vehicleUsage], map: "idx_vehicles_usage")
  @@index([status], map: "idx_vehicles_status")
  @@index([tenantId], map: "idx_vehicles_tenant_id")
  @@index([homeDepotId], map: "idx_vehicles_home_depot")
  @@index([tenantId])
  @@map("vehicles")
  @@schema("public")
}

