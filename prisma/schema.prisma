  @@index([tenantId], map: "idx_finance_debit_notes_tenant")
  @@index([status], map: "idx_finance_debit_notes_status")
  @@index([originalPayableId], map: "idx_finance_debit_notes_payable")
  @@index([originalInvoiceId], map: "idx_finance_debit_notes_invoice")
  @@map("finance_debit_notes")
  @@schema("finance")
}

// ── Finance Payment Allocations ───────────────────────────────────────────────
//
// Many-to-many join between finance_payments and finance_invoices (AR) or
// finance_payables (AP). One payment can be split across multiple documents;
// partial allocation is supported (allocated_amount < document total_amount).
//
// After each write a DB trigger (fn_sync_alloc_paid_amount) recalculates
// paid_amount and payment_status on the linked document automatically.
model FinancePaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  paymentId String         @map("payment_id") @db.Uuid
