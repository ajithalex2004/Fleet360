model OutsourceRequest {
  id                  String                    @id @default(uuid())
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId            String                    @map("tenant_id")
  requestNumber       String                    @unique @map("request_number")

  domain              PartnerServiceDomain      @default(PASSENGER_TRANSPORT) @map("domain")
  sourceReferenceType String                    @default("TRIP_SCHEDULE") @map("source_reference_type")
  sourceReferenceId   String                    @map("source_reference_id")

  pricingMethod       OutsourcePricingMethod    @default(RFQ) @map("pricing_method")
  status              OutsourceRequestStatus    @default(PUBLISHED) @map("status")

  serviceDate         DateTime                  @map("service_date") @db.Date
  pickupTime          String                    @map("pickup_time")
  pickupLocation      String                    @map("pickup_location")
  pickupLatitude      Float?                    @map("pickup_latitude")
  pickupLongitude     Float?                    @map("pickup_longitude")
  dropoffLocation     String                    @map("dropoff_location")
  dropoffLatitude     Float?                    @map("dropoff_latitude")
  dropoffLongitude    Float?                    @map("dropoff_longitude")
  requiredCapacity    Int                       @default(50) @map("required_capacity")
  vehicleTypeRequired String?                   @map("vehicle_type_required")
  specialInstructions String?                   @map("special_instructions")

  invitedPartners     OutsourceRequestPartner[]
  quotes              PartnerQuote[]
  award               OutsourceAward?
  opportunity         MarketplaceOpportunity?

  @@index([tenantId, status], map: "idx_outsource_req_tenant_status")
  @@map("outsource_requests")
  @@schema("public")
}

model MarketplaceOpportunity {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId            String               @map("tenant_id")
  outsourceRequestId  String               @unique @map("outsource_request_id")
  domain              PartnerServiceDomain @map("domain")
  visibility          OutsourceVisibility  @default(EXCHANGE_NETWORK) @map("visibility")
  status              String               @default("OPEN") // OPEN, AWARDED, CLOSED, CANCELLED
  publishedAt         DateTime             @default(now()) @map("published_at") @db.Timestamptz(6)
  closesAt            DateTime             @map("closes_at") @db.Timestamptz(6)
  disclosurePayload   Json                 @map("disclosure_payload")
  requirementsVersion Int                  @default(1) @map("requirements_version")
  createdBy           String               @map("created_by")

  request             OutsourceRequest     @relation(fields: [outsourceRequestId], references: [id], onDelete: Cascade)

  @@index([domain, status, visibility], map: "idx_marketplace_opps_domain_status")
  @@index([tenantId], map: "idx_marketplace_opps_tenant")
  @@map("marketplace_opportunities")
  @@schema("public")
}

model OutsourceRequestPartner {
  id            String                  @id @default(uuid())
  requestId     String                  @map("request_id")
  partnerId     String                  @map("partner_id")
  invitedAt     DateTime                @default(now()) @map("invited_at") @db.Timestamptz(6)
  viewedAt      DateTime?               @map("viewed_at") @db.Timestamptz(6)
  declinedAt    DateTime?               @map("declined_at") @db.Timestamptz(6)
  declineReason OutsourceDeclineReason? @map("decline_reason")
  declineNotes  String?                 @map("decline_notes")
  status        String                  @default("INVITED") // INVITED, VIEWED, QUOTED, DECLINED, NOT_SELECTED, AWARDED

  request       OutsourceRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  partner       TransportPartner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([requestId, partnerId], map: "uq_outsource_req_partner")
  @@map("outsource_request_partners")
  @@schema("public")
}

model PartnerQuote {
  id                String             @id @default(uuid())
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  requestId         String             @map("request_id")
  partnerId         String             @map("partner_id")
  revisionNo        Int                @default(1) @map("revision_no")
  supersedesQuoteId String?            @map("supersedes_quote_id")

  amount            Decimal            @map("amount") @db.Decimal(12, 2)
  vatAmount         Decimal            @default(0) @map("vat_amount") @db.Decimal(12, 2)
  totalAmount       Decimal            @map("total_amount") @db.Decimal(12, 2)
  currency          String             @default("AED")
  validUntil        DateTime           @map("valid_until") @db.Timestamptz(6)
  status            PartnerQuoteStatus @default(SUBMITTED) @map("status")
  notes             String?

  proposedVehicleId String?            @map("proposed_vehicle_id")
  proposedDriverId  String?            @map("proposed_driver_id")

  request           OutsourceRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  partner           TransportPartner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  award             OutsourceAward?

  @@index([requestId, partnerId], map: "idx_partner_quotes_req_partner")
  @@map("partner_quotes")
  @@schema("public")
}

model OutsourceAward {
  id                  String             @id @default(uuid())
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId            String             @map("tenant_id")
  requestId           String             @unique @map("request_id")
  quoteId             String             @unique @map("quote_id")
  partnerId           String             @map("partner_id")

  awardedPrice        Decimal            @map("awarded_price") @db.Decimal(12, 2)
  vatAmount           Decimal            @default(0) @map("vat_amount") @db.Decimal(12, 2)
  totalAwarded        Decimal            @map("total_awarded") @db.Decimal(12, 2)
  currency            String             @default("AED")
  commercialSnapshot  Json               @map("commercial_snapshot")

  awardedAt           DateTime           @default(now()) @map("awarded_at") @db.Timestamptz(6)
  awardedBy           String             @map("awarded_by")
  status              String             @default("AWARDED") // AWARDED, ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED, ABORTED
  abortedAt           DateTime?          @map("aborted_at") @db.Timestamptz(6)
  abortReason         String?            @map("abort_reason")

  request             OutsourceRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quote               PartnerQuote       @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  partner             TransportPartner   @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  assignment          PartnerAssignment?
  invoice             PartnerInvoice?
  exceptions          OutsourceException[]

  @@index([tenantId], map: "idx_outsource_awards_tenant")
  @@index([partnerId], map: "idx_outsource_awards_partner")
  @@map("outsource_awards")
  @@schema("public")
}

model PartnerAssignment {
  id              String                      @id @default(uuid())
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  awardId         String                      @unique @map("award_id")
  partnerId       String                      @map("partner_id")

  vehicleId       String?                     @map("vehicle_id")
  vehiclePlate    String?                     @map("vehicle_plate")
  driverId        String?                     @map("driver_id")
  driverName      String?                     @map("driver_name")
  driverPhone     String?                     @map("driver_phone")

  // Driver Secure Link (Hashed with SHA-256)
  driverTokenHash String                      @unique @map("driver_token_hash")
  driverTokenExp  DateTime                    @map("driver_token_exp") @db.Timestamptz(6)
  isTokenRevoked  Boolean                     @default(false) @map("is_token_revoked")

  // Execution Timestamps
  driverAssignedAt DateTime?                  @map("driver_assigned_at") @db.Timestamptz(6)
  reachedAt       DateTime?                   @map("reached_at") @db.Timestamptz(6)
  startedAt       DateTime?                   @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?                   @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?                   @map("cancelled_at") @db.Timestamptz(6)

  award           OutsourceAward              @relation(fields: [awardId], references: [id], onDelete: Cascade)
  pod             OutsourcePod?
  events          PartnerTripEvent[]
  revisions       PartnerAssignmentRevision[]

  @@index([driverTokenHash], map: "idx_assignment_driver_token_hash")
  @@map("partner_assignments")
  @@schema("public")
}

model PartnerAssignmentRevision {
  id             String            @id @default(uuid())
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  assignmentId   String            @map("assignment_id")
  revisionNo     Int               @default(1) @map("revision_no")
  vehiclePlate   String            @map("vehicle_plate")
  driverName     String            @map("driver_name")
  driverPhone    String            @map("driver_phone")
  replacedReason String?           @map("replaced_reason")
  replacedBy     String            @map("replaced_by")

  assignment     PartnerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId], map: "idx_assignment_revisions")
  @@map("partner_assignment_revisions")
  @@schema("public")
}

model OutsourceException {
  id              String                   @id @default(uuid())
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId        String                   @map("tenant_id")
  partnerId       String                   @map("partner_id")
  awardId         String?                  @map("award_id")
  assignmentId    String?                  @map("assignment_id")
  type            OutsourceExceptionType   @map("type")
  status          OutsourceExceptionStatus @default(RAISED) @map("status")
  severity        String                   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  description     String
  resolutionNotes String?                  @map("resolution_notes")
  raisedBy        String                   @map("raised_by")
  resolvedAt      DateTime?                @map("resolved_at") @db.Timestamptz(6)
  resolvedBy      String?                  @map("resolved_by")

  award           OutsourceAward?          @relation(fields: [awardId], references: [id], onDelete: SetNull)
  partner         TransportPartner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId, status], map: "idx_outsource_exceptions_tenant")
  @@index([partnerId], map: "idx_outsource_exceptions_partner")
  @@map("outsource_exceptions")
  @@schema("public")
}

model PartnerTripEvent {
  id           String            @id @default(uuid())
  assignmentId String            @map("assignment_id")
  eventType    String            @map("event_type") // REACHED, STARTED, COMPLETED, POD_SUBMITTED, TOKEN_ROTATED, TOKEN_REVOKED
  occurredAt   DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actor        String            @default("DRIVER") @map("actor")
  latitude     Float?            @map("latitude")
  longitude    Float?            @map("longitude")
  payload      Json?             @map("payload")

  assignment   PartnerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, occurredAt], map: "idx_trip_event_assignment")
  @@map("partner_trip_events")
  @@schema("public")
}

model OutsourcePod {
  id              String            @id @default(uuid())
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  assignmentId    String            @unique @map("assignment_id")
  passengerCount  Int?              @map("passenger_count")
  signedByName    String?           @map("signed_by_name")
  signatureUrl    String?           @map("signature_url")
  photoUrl        String?           @map("photo_url")
  completionNotes String?           @map("completion_notes")
  submittedAt     DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)

  assignment      PartnerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("outsource_pods")
  @@schema("public")
}

model PartnerInvoice {
  id                 String               @id @default(uuid())
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  partnerId          String               @map("partner_id")
  tenantId           String               @map("tenant_id")
  awardId            String               @unique @map("award_id")

  invoiceNumber      String               @map("invoice_number")
  invoiceDate        DateTime             @map("invoice_date") @db.Date
  subtotalAmount     Decimal              @map("subtotal_amount") @db.Decimal(12, 2)
  vatAmount          Decimal              @default(0) @map("vat_amount") @db.Decimal(12, 2)
  totalAmount        Decimal              @map("total_amount") @db.Decimal(12, 2)
  currency           String               @default("AED")
  status             String               @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED, PAID
  verificationStatus String               @default("MATCHED") @map("verification_status") // MATCHED, VARIANCE_REVIEW

  approvedAmount     Decimal?             @map("approved_amount") @db.Decimal(12, 2)
  approvedAt         DateTime?            @map("approved_at") @db.Timestamptz(6)
  approvedBy         String?              @map("approved_by")
  rejectionReason    String?              @map("rejection_reason")

  // Linkage to Core Finance AP
  payableId              String?                     @map("payable_id")
  settlementStatementId  String?                     @map("settlement_statement_id")

  award                  OutsourceAward              @relation(fields: [awardId], references: [id], onDelete: Restrict)
  partner                TransportPartner            @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  statement              PartnerSettlementStatement? @relation(fields: [settlementStatementId], references: [id], onDelete: SetNull)
  items                  PartnerInvoiceItem[]
  disputes               OutsourceDispute[]

  @@unique([partnerId, invoiceNumber], map: "uq_partner_invoice_number")
  @@index([tenantId, status], map: "idx_partner_invoices_tenant_status")
  @@map("partner_invoices")
  @@schema("public")
}

model PartnerInvoiceItem {
  id             String                 @id @default(uuid())
  invoiceId      String                 @map("invoice_id")
  description    String
  varianceReason InvoiceVarianceReason? @map("variance_reason")
  quantity       Decimal                @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal                @map("unit_price") @db.Decimal(12, 2)
  amount         Decimal                @db.Decimal(12, 2)
  vatAmount      Decimal                @default(0) @map("vat_amount") @db.Decimal(12, 2)
  totalAmount    Decimal                @map("total_amount") @db.Decimal(12, 2)

  invoice        PartnerInvoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("partner_invoice_items")
  @@schema("public")
}

model PartnerSettlementStatement {
  id               String                    @id @default(uuid())
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId         String                    @map("tenant_id")
  partnerId        String                    @map("partner_id")
  statementNumber  String                    @map("statement_number")
  periodStart      DateTime                  @map("period_start") @db.Date
  periodEnd        DateTime                  @map("period_end") @db.Date

  grossAmount      Decimal                   @map("gross_amount") @db.Decimal(12, 2)
  vatAmount        Decimal                   @default(0) @map("vat_amount") @db.Decimal(12, 2)
  totalDeductions  Decimal                   @default(0) @map("total_deductions") @db.Decimal(12, 2)
  netPayable       Decimal                   @map("net_payable") @db.Decimal(12, 2)
  currency         String                    @default("AED")
  status           SettlementStatementStatus @default(DRAFT) @map("status")

  tenantTrn        String?                   @map("tenant_trn")
  partnerTrn       String?                   @map("partner_trn")
  paymentReference String?                   @map("payment_reference")
  paidAt           DateTime?                 @map("paid_at") @db.Timestamptz(6)

  partner          TransportPartner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  invoices         PartnerInvoice[]
  deductions       SettlementDeduction[]

  @@unique([tenantId, statementNumber], map: "uq_settlement_statement_number")
  @@index([tenantId, status], map: "idx_settlement_tenant_status")
  @@map("partner_settlement_statements")
  @@schema("public")
}

model SettlementDeduction {
  id           String                     @id @default(uuid())
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  statementId  String                     @map("statement_id")
  invoiceId    String?                    @map("invoice_id")
  type         DeductionType              @map("type")
  description  String
  amount       Decimal                    @db.Decimal(12, 2)
  appliedBy    String                     @map("applied_by")

  statement    PartnerSettlementStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@map("settlement_deductions")
  @@schema("public")
}

model OutsourceDispute {
  id              String           @id @default(uuid())
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId        String           @map("tenant_id")
  partnerId       String           @map("partner_id")
  invoiceId       String           @map("invoice_id")
  invoiceItemId   String?          @map("invoice_item_id")
  disputeNumber   String           @unique @map("dispute_number")
  disputedAmount  Decimal          @map("disputed_amount") @db.Decimal(12, 2)
  status          DisputeStatus    @default(OPEN) @map("status")
  reason          String
  resolutionNotes String?          @map("resolution_notes")
  resolvedAmount  Decimal?         @map("resolved_amount") @db.Decimal(12, 2)
  creditNoteRef   String?          @map("credit_note_ref")
  raisedBy        String           @map("raised_by")
  resolvedAt      DateTime?        @map("resolved_at") @db.Timestamptz(6)
  resolvedBy      String?          @map("resolved_by")

  invoice         PartnerInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  partner         TransportPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId, status], map: "idx_disputes_tenant_status")
  @@map("outsource_disputes")
  @@schema("public")
}

model PartnerScorecard {
  id                String                 @id @default(uuid())
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  partnerId         String                 @unique @map("partner_id")
  tenantId          String?                @map("tenant_id")

  tier              PartnerPerformanceTier @default(STANDARD) @map("tier")
  compositeScore    Float                  @default(100.0) @map("composite_score")

  // Core KPI Breakdown (Percentages 0 - 100)
  onTimePerformance Float                  @default(100.0) @map("on_time_performance")
  quoteResponseRate Float                  @default(100.0) @map("quote_response_rate")
  exceptionRate     Float                  @default(0.0) @map("exception_rate")
  disputeRate       Float                  @default(0.0) @map("dispute_rate")
  podQualityRate    Float                  @default(100.0) @map("pod_quality_rate")

  // Volume Counters
  totalAwardedTrips Int                    @default(0) @map("total_awarded_trips")
  completedTrips    Int                    @default(0) @map("completed_trips")
  onTimeTrips       Int                    @default(0) @map("on_time_trips")
  lateTrips         Int                    @default(0) @map("late_trips")
  exceptionsCount   Int                    @default(0) @map("exceptions_count")
  disputesCount     Int                    @default(0) @map("disputes_count")
  quotesSubmitted   Int                    @default(0) @map("quotes_submitted")
  quotesInvited     Int                    @default(0) @map("quotes_invited")

  evaluatedAt       DateTime               @default(now()) @map("evaluated_at") @db.Timestamptz(6)

  partner           TransportPartner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tier, compositeScore], map: "idx_scorecard_tier_score")
  @@map("partner_scorecards")
  @@schema("public")
}

