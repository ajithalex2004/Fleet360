generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "finance", "ai", "workforce", "fleet", "operations", "spatial"]
}

model ChecklistItem {
  id          String    @id
  task        String
  completed   Boolean   @default(false)
  completedBy String?
  completedAt DateTime?
  notes       String?
  workOrderId String
  WorkOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  @@schema("public")
}

model IntegrationConfig {
  id          String   @id
  type        String   @unique
  provider    String
  host        String?
  port        String?
  username    String?
  password    String?
  apiKey      String?
  apiSecret   String?
  senderId    String?
  senderEmail String?
  fromName    String?
  encryption  String?
  accountSid  String?
  authToken   String?
  fromNumber  String?
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime

  @@schema("public")
}

model NotificationLog {
  id            String   @id
  recipient     String
  type          String
  subject       String?
  body          String?
  status        String
  sentAt        DateTime @default(now())
  triggerReason String?

  @@schema("public")
}

model PartUsage {
  id           String     @id
  partName     String
  quantityUsed Int
  unitCost     Float
  totalCost    Float
  source       PartSource
  workOrderId  String
  WorkOrder    WorkOrder  @relation(fields: [workOrderId], references: [id])

  @@schema("public")
}

model ServiceSchedule {
  id                 String   @id
  serviceType        String
  intervalMonths     Int
  intervalMileage    Int
  lastServiceDate    DateTime
  lastServiceMileage Int
  nextServiceDate    DateTime
  nextServiceMileage Int
  vehicleId          String
  Vehicle            Vehicle  @relation(fields: [vehicleId], references: [id])

  @@schema("public")
}

// ============================================================
// PREVENTIVE MAINTENANCE ENGINE
// ============================================================

model MaintenancePlan {
  id               String    @id @default(uuid())
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId         String    @map("tenant_id")
  name             String
  description      String?
  maintenanceType  String?   @map("maintenance_type")
  /// JSON: { allVehicles: bool, vehicleIds?: string[], vehicleTypes?: string[] }
  applicability    Json?
  gracePeriodDays  Int?      @map("grace_period_days")
  earlyWindowDays  Int?      @map("early_window_days")
  earlyWindowKm    Int?      @map("early_window_km")
  isActive         Boolean   @default(true) @map("is_active")
  notifyDaysBefore Int?      @map("notify_days_before")

  triggers      PMTrigger[]
  scheduleItems PMScheduleItem[]

  @@index([tenantId], map: "idx_maintenance_plans_tenant_id")
  @@index([deletedAt], map: "idx_maintenance_plans_deleted_at")
  @@index([isActive], map: "idx_maintenance_plans_is_active")
  @@map("maintenance_plans")
  @@schema("public")
}

model PMTrigger {
  id            String        @id @default(uuid())
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  planId        String        @map("plan_id")
  triggerType   PMTriggerType @map("trigger_type")
  /// Numeric interval: km for ODOMETER, days for CALENDAR, hours for ENGINE_HOURS
  intervalValue Int           @map("interval_value")
  /// KM | DAYS | HOURS
  intervalUnit  String        @map("interval_unit")

  plan MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId], map: "idx_pm_triggers_plan_id")
  @@map("pm_triggers")
  @@schema("public")
}

model PMScheduleItem {
  id                 String       @id @default(uuid())
  createdAt          DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId           String       @map("tenant_id")
  planId             String       @map("plan_id")
  vehicleId          String       @map("vehicle_id")
  lastServiceDate    DateTime?    @map("last_service_date") @db.Timestamptz(6)
  lastOdometerKm     Int?         @map("last_odometer_km")
  /// Pre-computed next due date from calendar trigger; refreshed on service completion
  nextDueDateCalc    DateTime?    @map("next_due_date_calc") @db.Timestamptz(6)
  /// Pre-computed next due odometer from odometer trigger; refreshed on service completion
  nextDueOdometerKm  Int?         @map("next_due_odometer_km")
  status             PMItemStatus @default(UPCOMING)
  generatedRequestId String?      @map("generated_request_id")

  plan MaintenancePlan @relation(fields: [planId], references: [id])

  @@unique([planId, vehicleId], map: "uniq_pm_schedule_items_plan_vehicle")
  @@index([tenantId], map: "idx_pm_schedule_items_tenant_id")
  @@index([vehicleId], map: "idx_pm_schedule_items_vehicle_id")
  @@index([status], map: "idx_pm_schedule_items_status")
  @@index([planId], map: "idx_pm_schedule_items_plan_id")
  @@map("pm_schedule_items")
  @@schema("public")
}

model User {
  id           String       @id
  username     String       @unique
  email        String       @unique
  mobileNumber String?
  hierarchy    String?
  userType     String?
  firstName    String?
  lastName     String?
  department   String?
  position     String?
  employeeId   String?      @unique
  // -- Admin Hub additions -------------------------------------------------
  isActive     Boolean      @default(true) @map("is_active")
  moduleAccess Json?        @map("module_access") // { fleet: true, maintenance: true, ... }
  lastLoginAt  DateTime?    @map("last_login_at")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  userTenants  UserTenant[]
  partnerUsers PartnerUser[]

  @@schema("public")
}

model WorkLog {
  id             String    @id
  timestamp      DateTime  @default(now())
  technicianName String
  activity       String
  hoursSpent     Float
  notes          String
  workOrderId    String
  WorkOrder      WorkOrder @relation(fields: [workOrderId], references: [id])

  @@schema("public")
}

model WorkOrder {
  id                      String             @id
  startDate               DateTime
  estimatedCompletionDate DateTime
  actualCompletionDate    DateTime?
  totalLaborHours         Float
  status                  WorkOrderStatus
  requestId               String             @unique
  garageId                String
  tenantId                String             @map("tenant_id")
  Attachment              Attachment[]
  ChecklistItem           ChecklistItem[]
  PartUsage               PartUsage[]
  WorkLog                 WorkLog[]
  jobCards                JobCard[]
  Garage                  Garage             @relation(fields: [garageId], references: [id])
  MaintenanceRequest      MaintenanceRequest @relation(fields: [requestId], references: [id])
  Tenant                  Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@schema("public")
}

model AlertConfig {
  id                  String    @id @default(uuid())
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId            String    @map("tenant_id")
  alertFor            String?   @map("alert_for")
  alertType           String?   @map("alert_type")
  frequency           String?
  frequencyValue      BigInt?   @map("frequency_value")
  dueAlertThreshold   String?   @map("due_alert_threshold")
  thresholdValue      BigInt?   @map("threshold_value")
  notificationEnabled Boolean?  @map("notification_enabled")
  whatsappEnabled     Boolean?  @map("whatsapp_enabled")
  assignedIds         String[]  @map("assigned_ids")

  @@index([deletedAt], map: "idx_alert_configs_deleted_at")
  @@index([tenantId], map: "idx_alert_configs_tenant_id")
  @@map("alert_configs")
  @@schema("public")
}

/// Alerts raised by the AlertEngine (or legacy direct writers).
///
/// Every module publishes `alert.condition_detected` events;
/// AlertEngineConsumer looks up an AlertRule by (tenantId, code) and
/// enriches the Alert row with SLA due dates, channels, recipients,
/// and initial escalation level. The escalation cron then re-notifies
/// at each configured level and marks SLA breaches.
///
/// Legacy `type` field is preserved for back-compat but new writers
/// should stamp `code` (the canonical AlertCondition constant).
model Alert {
  id              String    @id @default(uuid())
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId        String    @map("tenant_id")
  type            String? /// Legacy free-text category; superseded by `code`.
  title           String?
  description     String?
  severity        String? /// LOW | MEDIUM | HIGH | CRITICAL
  dateCreated     DateTime? @map("date_created") @db.Timestamptz(6)
  relatedEntityId String?   @map("related_entity_id")
  status          String?
  assignedTo      String?   @map("assigned_to")

  // ── Alert engine (Phase 1) ──────────────────────────────────────────
  /// Machine-readable condition code — see AlertCondition constants in
  /// src/events/contracts/alert.events.ts.
  code            String?
  sourceModule    String?   @map("source_module")
  sourceEventId   String?   @map("source_event_id") @db.Uuid
  subjectType     String?   @map("subject_type") /// TripSchedule | Vehicle | Driver | Passenger | Route | Stop
  subjectId       String?   @map("subject_id")
  /// Dedup guard — while an Alert with this key is OPEN (not resolved),
  /// no new Alert with the same (tenantId, dedupeKey) can be raised.
  dedupeKey       String?   @map("dedupe_key")
  channels        String[] /// PUSH | SMS | WHATSAPP | EMAIL | IN_APP
  recipients      String[] /// Role names or CUSTOM user ids
  context         Json? /// Free-form event context — tripNumber, vehicle plate, etc.
  acknowledgedAt  DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy  String?   @map("acknowledged_by")
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy      String?   @map("resolved_by")
  resolutionNote  String?   @map("resolution_note")
  slaAckDueAt     DateTime? @map("sla_ack_due_at") @db.Timestamptz(6)
  slaResolveDueAt DateTime? @map("sla_resolve_due_at") @db.Timestamptz(6)
  escalationLevel Int       @default(0) @map("escalation_level")
  lastEscalatedAt DateTime? @map("last_escalated_at") @db.Timestamptz(6)

  @@index([deletedAt], map: "idx_alerts_deleted_at")
  @@index([tenantId], map: "idx_alerts_tenant_id")
  @@index([code], map: "idx_alerts_code")
  @@index([sourceModule, sourceEventId], map: "idx_alerts_source")
  @@index([subjectType, subjectId], map: "idx_alerts_subject")
  @@map("alerts")
  @@schema("public")
}

/// Per-tenant, per-condition routing config for AlertEngineConsumer.
///
/// One row per (tenantId, code). If no row exists for a condition, the
/// engine falls back to sensible defaults (severity=MEDIUM, no channels,
/// no SLA, no escalation) — the Alert is still created but nobody's
/// notified until ops configures the rule.
model AlertRule {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId  String    @map("tenant_id")

  code      String
  isEnabled Boolean @default(true) @map("is_enabled")

  defaultSeverity      String   @default("MEDIUM") @map("default_severity")
  defaultChannels      String[] @map("default_channels")
  recipientTypes       String[] @map("recipient_types")
  specificRecipientIds String[] @map("specific_recipient_ids")

  slaAckMinutes     Int? @map("sla_ack_minutes")
  slaResolveMinutes Int? @map("sla_resolve_minutes")

  /// Escalation ladder — [{ afterMinutes, channels, recipients }, ...]
  /// Applied by the escalation cron in order.
  escalationLevels Json? @map("escalation_levels")

  @@unique([tenantId, code], map: "uq_alert_rules_tenant_code")
  @@index([tenantId], map: "idx_alert_rules_tenant_id")
  @@index([deletedAt], map: "idx_alert_rules_deleted_at")
  @@map("alert_rules")
  @@schema("public")
}

model Attachment {
  id                   String              @id @default(uuid())
  createdAt            DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tenantId             String              @map("tenant_id")
  maintenanceRequestId String?             @map("maintenance_request_id")
  serviceRequestId     String?             @map("service_request_id")
  quotationId          String?             @map("quotation_id")
  workOrderId          String?             @map("work_order_id")
  invoiceId            String?             @map("invoice_id")
  type                 String?
  fileName             String?             @map("file_name")
  url                  String?
  MaintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_maintenance_requests_attachments")
  Quotation            Quotation?          @relation(fields: [quotationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_quotations_attachments")
  ServiceRequest       ServiceRequest?     @relation(fields: [serviceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_service_requests_attachments")
  Invoice              Invoice?            @relation(fields: [invoiceId], references: [id])
  WorkOrder            WorkOrder?          @relation(fields: [workOrderId], references: [id])

  @@index([deletedAt], map: "idx_attachments_deleted_at")
  @@index([tenantId], map: "idx_attachments_tenant_id")
  @@map("attachments")
  @@schema("public")
}

model Comment {
  id                   String              @id @default(uuid())
  createdAt            DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tenantId             String              @map("tenant_id")
  maintenanceRequestId String?             @map("maintenance_request_id")
  author               String?
  text                 String?
  timestamp            DateTime?           @db.Timestamptz(6)
  MaintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_maintenance_requests_comments")

  @@index([deletedAt], map: "idx_comments_deleted_at")
  @@index([tenantId], map: "idx_comments_tenant_id")
  @@map("comments")
  @@schema("public")
}

model Driver {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId  String    @map("tenant_id")

  // -- Identity (Driver Hub core fields) --------------------------------------
  name          String?
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  email         String?
  contactNumber String?   @map("contact_number")
  nationality   String?
  dob           DateTime? @db.Timestamptz(6)

  // -- Licence & Compliance -------------------------------------------------
  licenseNumber    String?   @unique(map: "idx_drivers_license_number") @map("license_number")
  licenseExpiry    DateTime? @map("license_expiry") @db.Timestamptz(6)
  licenseType      String?   @map("license_type") // LIGHT|HEAVY|BUS|MOTORCYCLE
  emiratesId       String?   @map("emirates_id")
  emiratesIdExpiry DateTime? @map("emirates_id_expiry") @db.Timestamptz(6)
  passportNumber   String?   @map("passport_number")
  passportExpiry   DateTime? @map("passport_expiry") @db.Timestamptz(6)
  visaExpiry       DateTime? @map("visa_expiry") @db.Timestamptz(6)

  // -- Organisational --------------------------------------------------------
  status                String?   @default("ACTIVE") // ACTIVE|INACTIVE|SUSPENDED
  driverType            String?   @map("driver_type") // PERMANENT|CONTRACT|OUTSOURCED
  hierarchy             String?
  communicationLanguage String?   @map("communication_language")
  dateOfJoin            DateTime? @map("date_of_join") @db.Timestamptz(6)
  dallasId              String?   @map("dallas_id")
  garageId              String?   @map("garage_id")

  // -- Assignment (operational -- updated by modules, not owned) -------------
  assignedVehicleId String? @map("assigned_vehicle_id")

  // -- Relations -------------------------------------------------------------
  maintenanceRequests MaintenanceRequest[]
  assignedVehicle     Vehicle?             @relation(fields: [assignedVehicleId], references: [id])

  @@index([deletedAt], map: "idx_drivers_deleted_at")
  @@index([status], map: "idx_drivers_status")
  @@index([tenantId], map: "idx_drivers_tenant_id")
  @@index([tenantId])
  @@map("drivers")
  @@schema("public")
}

model Garage {
  id                  String               @id @default(uuid())
  createdAt           DateTime?            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime?            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(6)
  tenantId            String               @map("tenant_id")
  name                String?
  location            String?
  contactPerson       String?              @map("contact_person")
  designation         String?
  email               String?
  contactNumber       String?              @map("contact_number")
  specialties         String[]
  isInternal          Boolean?             @map("is_internal")
  /// Optional link to a spatial.places row of type GARAGE. Phase 3b addition
  /// — no reader uses this yet; consumers still read `location` (text).
  /// Phase 3.5 migrates readers so the Place row becomes the geospatial
  /// source of truth.
  placeId             String?              @map("place_id")
  place               Place?               @relation("GaragePlace", fields: [placeId], references: [id], onDelete: SetNull)
  maintenanceRequests MaintenanceRequest[]
  quotations          Quotation[]
  workOrders          WorkOrder[]

  @@index([deletedAt], map: "idx_garages_deleted_at")
  @@index([tenantId], map: "idx_garages_tenant_id")
  @@index([placeId], map: "idx_garages_place_id")
  @@map("garages")
  @@schema("public")
}

model StatusHistory {
  id                   String              @id @default(uuid())
  createdAt            DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tenantId             String              @map("tenant_id")
  maintenanceRequestId String?             @map("maintenance_request_id")
  serviceRequestId     String?             @map("service_request_id")
  status               String?
  date                 DateTime?           @db.Timestamptz(6)
  note                 String?
  actor                String?
  MaintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_maintenance_requests_history")
  ServiceRequest       ServiceRequest?     @relation(fields: [serviceRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_service_requests_history")

  @@index([deletedAt], map: "idx_histories_deleted_at")
  @@index([tenantId], map: "idx_histories_tenant_id")
  @@map("histories")
  @@schema("public")
}

model InvoiceLineItem {
  id          String    @id @default(uuid())
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  invoiceId   String?   @map("invoice_id")
  description String?
  quantity    BigInt?
  unitPrice   Decimal?  @map("unit_price") @db.Decimal
  totalPrice  Decimal?  @map("total_price") @db.Decimal
  category    String?
  Invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_invoices_line_items")

  @@index([deletedAt], map: "idx_invoice_line_items_deleted_at")
  @@map("invoice_line_items")
  @@schema("public")
}

model Invoice {
  id               String            @id @default(uuid())
  createdAt        DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)
  invoiceNumber    String?           @unique(map: "idx_invoices_invoice_number") @map("invoice_number")
  requestId        String?           @map("request_id")
  garageId         String?           @map("garage_id")
  invoiceDate      DateTime?         @map("invoice_date") @db.Timestamptz(6)
  dueDate          DateTime?         @map("due_date") @db.Timestamptz(6)
  totalAmount      Decimal?          @map("total_amount") @db.Decimal
  paidAmount       Decimal?          @map("paid_amount") @db.Decimal
  paymentStatus    String?           @map("payment_status")
  invoiceLineItems InvoiceLineItem[]
  attachments      Attachment[]

  @@index([deletedAt], map: "idx_invoices_deleted_at")
  @@index([garageId], map: "idx_invoices_garage_id")
  @@index([paymentStatus], map: "idx_invoices_payment_status")
  @@map("invoices")
  @@schema("public")
}

model MaintenanceRequest {
  id                  String              @id @default(uuid())
  createdAt           DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime?           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tenantId            String              @map("tenant_id")
  vehicleId           String?             @map("vehicle_id")
  driverId            String?             @map("driver_id")
  requestDate         DateTime?           @map("request_date") @db.Timestamptz(6)
  description         String?
  status              String?
  expectedEndDate     DateTime?           @map("expected_end_date") @db.Timestamptz(6)
  garageId            String?             @map("garage_id")
  estimatedCost       Decimal?            @map("estimated_cost") @db.Decimal
  actualCost          Decimal?            @map("actual_cost") @db.Decimal
  actualPartsCost     Decimal?            @map("actual_parts_cost") @db.Decimal
  actualLaborCost     Decimal?            @map("actual_labor_cost") @db.Decimal
  actualOtherCost     Decimal?            @map("actual_other_cost") @db.Decimal
  completionDate      DateTime?           @map("completion_date") @db.Timestamptz(6)
  maintenanceType     String?             @map("maintenance_type")
  priority            String?
  workOrderNo         String?             @map("work_order_no")
  odometer            BigInt?
  candidateGarageIds  String?             @map("candidate_garage_ids")
  maintenanceJobs     String[]            @map("maintenance_jobs")
  estimateApproval    String?             @map("estimate_approval")
  workLog             String?             @map("work_log")
  partsUsed           String?             @map("parts_used")
  checklistItems      String?             @map("checklist_items")
  assignedTechnicians String?             @map("assigned_technicians")
  actualCostsData     String?             @map("actual_costs_data")
  /// Set on COMPLETED/CLOSED — FK to finance.finance_payables.id
  financePayableId    String?             @map("finance_payable_id")
  /// Set on COMPLETED/CLOSED — FK to finance_journal_entries.id
  financeJeId         String?             @map("finance_je_id")
  /// Populated when this MR was auto-created from a breakdown report
  breakdownReportId   String?             @map("breakdown_report_id")
  attachments         Attachment[]
  comments            Comment[]
  histories           StatusHistory[]
  Driver              Driver?             @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_maintenance_requests_driver")
