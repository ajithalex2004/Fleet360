// ── Finance Debit Notes ───────────────────────────────────────────────────────
//
// Symmetric to FinanceCreditNote.
// AP-side: raised against a payable (vendor overcharged → reduce AP balance)
// AR-side: raised against an invoice (customer owes more → increase AR balance)
// Lifecycle: DRAFT → ISSUED → APPLIED | VOIDED
model FinanceDebitNote {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
