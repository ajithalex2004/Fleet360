// -- Rental Invoicing ------------------------------------------
model RentalInvoice {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation("RentalInvoiceToTenant", fields: [tenantId], references: [id])

  invoiceNo   String @map("invoice_no")
  agreementId String @map("agreement_id")
  customerId  String @map("customer_id")

  // Invoice type
  invoiceType String? @default("STANDARD") @map("invoice_type")
  // STANDARD | PRE_BILLING | MONTHLY | COMBINATION | CREDIT_NOTE

  // Dates
  invoiceDate DateTime  @map("invoice_date") @db.Timestamptz(6)
  dueDate     DateTime  @map("due_date") @db.Timestamptz(6)
  periodFrom  DateTime? @map("period_from") @db.Timestamptz(6)
  periodTo    DateTime? @map("period_to") @db.Timestamptz(6)

  // Amounts
  currency       String?  @default("AED")
  subtotal       Decimal  @db.Decimal
  discountAmount Decimal? @default(0) @map("discount_amount") @db.Decimal
  taxablAmount   Decimal? @default(0) @map("taxable_amount") @db.Decimal
  taxRate        Decimal? @default(5) @map("tax_rate") @db.Decimal // UAE VAT 5%
  taxAmount      Decimal? @default(0) @map("tax_amount") @db.Decimal
  totalAmount    Decimal  @map("total_amount") @db.Decimal
  paidAmount     Decimal? @default(0) @map("paid_amount") @db.Decimal
  balanceDue     Decimal? @map("balance_due") @db.Decimal

  // Status
  status String? @default("DRAFT") @map("status")
  // DRAFT | SENT | PARTIALLY_PAID | PAID | OVERDUE | VOID | DISPUTED

  // Corporate invoicing
  isCorporate        Boolean? @default(false) @map("is_corporate")
  corporateAccountId String?  @map("corporate_account_id")
  billingMode        String?  @default("SEPARATE") @map("billing_mode") // SEPARATE|COMBINED

  // Payment & collection
  paymentTermsDays Int?      @default(30) @map("payment_terms_days")
  sentAt           DateTime? @map("sent_at") @db.Timestamptz(6)
  paidAt           DateTime? @map("paid_at") @db.Timestamptz(6)
  voidedAt         DateTime? @map("voided_at") @db.Timestamptz(6)
  voidReason       String?   @map("void_reason")

  // Reference to parent invoice (for credit notes)
  parentInvoiceId String? @map("parent_invoice_id")

  notes         String?
  internalNotes String? @map("internal_notes")

  agreement       RentalAgreement         @relation(fields: [agreementId], references: [id])
  lineItems       RentalInvoiceLineItem[]
  receiptPayments RentalInvoicePayment[]

  @@unique([tenantId, invoiceNo], map: "uq_rental_invoices_tenant_no")
  @@index([tenantId], map: "idx_rental_invoices_tenant_id")
  @@index([agreementId], map: "idx_rental_invoices_agreement_id")
  @@index([customerId], map: "idx_rental_invoices_customer_id")
  @@index([status], map: "idx_rental_invoices_status")
  @@index([dueDate], map: "idx_rental_invoices_due_date")
  @@index([deletedAt], map: "idx_rental_invoices_deleted_at")
  @@index([corporateAccountId], map: "idx_rental_invoices_corporate_account_id")
  @@index([tenantId])
  @@map("rental_invoices")
  @@schema("public")
}

model RentalInvoiceLineItem {
  id          String        @id @default(uuid())
  createdAt   DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId    String        @map("tenant_id")
  tenant      Tenant        @relation("RentalInvoiceLineItemToTenant", fields: [tenantId], references: [id])
  invoiceId   String        @map("invoice_id")
  lineType    String        @map("line_type")
  // RENTAL|INSURANCE|FUEL|EXTRA_KM|DAMAGE|TRAFFIC_FINE|CLEANING|EXTENSION|DEPOSIT|DISCOUNT|TAX|OTHER
  description String
  quantity    Decimal       @db.Decimal
  unitPrice   Decimal       @map("unit_price") @db.Decimal
  unitLabel   String?       @default("day") @map("unit_label") // day|km|hour|flat
  discountPct Decimal?      @default(0) @map("discount_pct") @db.Decimal
  taxable     Boolean?      @default(true)
  amount      Decimal       @db.Decimal // qty * unitPrice - discount
  sortOrder   Int?          @default(0) @map("sort_order")
  referenceId String?       @map("reference_id") // chargeId, trafficFineId etc.
  invoice     RentalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_rental_invoice_line_items_tenant_id")
  @@index([invoiceId], map: "idx_rental_invoice_line_items_invoice_id")
  @@map("rental_invoice_line_items")
  @@schema("public")
}

// Payment receipts against an invoice
model RentalInvoicePayment {
  id            String        @id @default(uuid())
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId      String        @map("tenant_id")
  tenant        Tenant        @relation("RentalInvoicePaymentToTenant", fields: [tenantId], references: [id])
  invoiceId     String        @map("invoice_id")
  amount        Decimal       @db.Decimal
  currency      String?       @default("AED")
  paymentMethod String?       @map("payment_method") // CASH|CARD|BANK|CHEQUE|ONLINE
  referenceNo   String?       @map("reference_no")
  receiptNo     String?       @map("receipt_no")
  paidAt        DateTime      @map("paid_at") @db.Timestamptz(6)
  receivedBy    String?       @map("received_by")
  notes         String?
  invoice       RentalInvoice @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, receiptNo], map: "uq_rental_invoice_payments_tenant_receipt")
  @@index([tenantId], map: "idx_rental_invoice_payments_tenant_id")
  @@index([invoiceId], map: "idx_rental_invoice_payments_invoice_id")
  @@map("rental_invoice_payments")
  @@schema("public")
}

// ============================================================
// MODULE 3: BUS OPERATIONS (STAFF TRANSPORTATION)
// ============================================================

model BusRoute {
  id                    String            @id @default(uuid())
  createdAt             DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime?         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?         @map("deleted_at") @db.Timestamptz(6)
  tenantId              String           @map("tenant_id")
  name                  String
  // Optional short code (e.g. "RT-001"). Tenant-scoped unique via
  // uniq_bus_routes_tenant_code (partial index — allows multiple NULLs).
  code                  String?
  origin                String
  destination           String
  routeType             String?           @default("STAFF") @map("route_type") // STAFF|SCHOOL|BOTH
  /// Vehicle group the route is authored for (BUS | VAN | PICKUP | SUV | ECONOMY | LUXURY …).
  /// When set, the Resource Validation Engine's V5 check compares this to
  /// Vehicle.vehicleGroup and BLOCKs mismatches. Null → V5 is a no-op (PASS)
  /// so tenants without a routing standard aren't false-alarmed.
  requiredVehicleGroup  String?           @map("required_vehicle_group")
  /// Minimum driver license category required for the route (LIGHT | HEAVY |
  /// BUS | MOTORCYCLE). Matches Driver.licenseType. Null → D7 is a no-op.
  /// Should reflect the most restrictive UAE RTA requirement for the route's
  /// typical vehicle — a bus route uses BUS, a shuttle van typically LIGHT.
  requiredLicenseType   String?           @map("required_license_type")
  /// FK to spatial.places(id) with type=OPERATIONAL_ZONE — the zone this
  /// route serves. Explicit tagging (not derived from stop geometry) —
  /// point-in-polygon zone inference is a possible later upgrade, not
  /// implemented yet. Used the same way as Vehicle.zoneId: a soft ranking
  /// signal for smart vehicle matching, never a hard eligibility filter.
  zoneId                String?           @map("zone_id")
  zone                  Place?            @relation("RouteZone", fields: [zoneId], references: [id], onDelete: SetNull)
  totalDistanceKm       Float?            @map("total_distance_km")
  estimatedDurationMins Int?              @map("estimated_duration_mins")
  capacity              Int?              @default(30)
  isActive              Boolean?          @default(true) @map("is_active")
  notes                 String?
  /// Route scheduling metadata authored on the Routes page. When present these
  /// are the "typical" scheduling for the route — TripSchedule and
  /// BusOpsScheduleTemplate can still override on a per-trip / per-template
  /// basis. All nullable so pre-existing rows are unaffected.
  direction             String?           @map("direction") // INBOUND | OUTBOUND
  shiftType             String?           @map("shift_type") // MORNING | EVENING | NIGHT | SPLIT
  departureTime         String?           @map("departure_time") // 'HH:MM' 24h
  expectedArrivalTime   String?           @map("expected_arrival_time") // 'HH:MM' 24h
  /// Default vehicle and driver for the route. Not enforced as FK on purpose
  /// (bus_routes is cross-tenant-referenced in some legacy contexts) — the
  /// Routes page validates the id belongs to the tenant on write.
  assignedVehicleId     String?           @map("assigned_vehicle_id")
  assignedDriverId      String?           @map("assigned_driver_id")
  /// Fleet routing / VRPTW — buffer (minutes) around this route's
  /// departureTime that individual pickups may slide within, letting the
  /// solver consolidate nearby stops onto one bus. Falls back to the
  /// tenant default when null. See src/lib/planning/fleet-routing/window-resolver.ts.
  pickupBufferMin       Int?              @map("pickup_buffer_min")
  /// Route Consolidation Phase 2 — retirement fields.
  /// Set when a route is deactivated as a consolidation source or as an
  /// archived merged route after revert. `retiredReason` discriminates
  /// consolidation-driven retirement from other operator-authored reasons
  /// so cool-down / analysis queries can filter cheaply.
  retiredReason         String?           @map("retired_reason")
  retiredAt             DateTime?         @map("retired_at") @db.Timestamptz(6)
  retiredBy             String?           @map("retired_by")
  stops                 RouteStop[]
  schedules             TripSchedule[]
  headwayRules          HeadwayRule[]
  /// Named direction variants (Morning→Office, Evening→Residence, …).
  /// Phase 1 of route versioning — see FOLLOWUP_ROUTE_VERSIONING.md.
  variants              BusRouteVariant[]
  passengers            RoutePassenger[]

  @@map("bus_routes")
  @@schema("public")
}

/// Named direction / variant of a route (Morning → Office, Evening →
/// Residence, Weekend). One row per route × variant. Each variant has
/// its own version history (BusRouteVariantVersion) so stops can differ
/// between directions AND across time within a direction. See
/// FOLLOWUP_ROUTE_VERSIONING.md for the migration strategy.
model BusRouteVariant {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId  String    @map("tenant_id")
  routeId   String    @map("route_id")

  name        String /// Display label — "Morning → Office"
  /// Canonical bucket for filtering / dispatch UI — MORNING | EVENING |
  /// INBOUND | OUTBOUND | WEEKEND | SPECIAL | NIGHT (free-text, extensible).
  kind        String?
  description String?
  isActive    Boolean @default(true) @map("is_active")
  createdBy   String? @map("created_by")

  route    BusRoute                 @relation(fields: [routeId], references: [id], onDelete: Cascade)
  versions BusRouteVariantVersion[]

  @@unique([routeId, name], map: "uq_bus_route_variants_route_name")
  @@index([routeId], map: "idx_bus_route_variants_route")
  @@index([tenantId], map: "idx_bus_route_variants_tenant")
  @@index([deletedAt], map: "idx_bus_route_variants_deleted")
  @@map("bus_route_variants")
  @@schema("public")
}

/// Immutable snapshot of a variant at a point in time. Publishing a new
/// version auto-closes the prior one's effectiveTo. Trips reference the
/// version they used so historical reporting reads the stops that
/// actually operated — not whatever the route looks like today.
model BusRouteVariantVersion {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId  String    @map("tenant_id")
  variantId String    @map("variant_id")

  versionNumber Int       @map("version_number")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  /// DRAFT | PUBLISHED | ARCHIVED
  status      String    @default("DRAFT")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy String?   @map("published_by")
  notes       String?

  variant BusRouteVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stops   RouteStop[]
  trips   TripSchedule[]

  @@unique([variantId, versionNumber], map: "uq_bus_route_variant_versions_variant_ver")
  @@index([variantId], map: "idx_bus_route_variant_versions_variant")
  @@index([tenantId], map: "idx_bus_route_variant_versions_tenant")
  @@index([status], map: "idx_bus_route_variant_versions_status")
  @@index([deletedAt], map: "idx_bus_route_variant_versions_deleted")
  @@map("bus_route_variant_versions")
  @@schema("public")
}

model RouteStop {
  id                   String                  @id @default(uuid())
  tenantId             String                 @map("tenant_id")
  routeId              String                  @map("route_id")
  stopName             String                  @map("stop_name")
  sequence             Int
  gpsLat               Float?                  @map("gps_lat")
  gpsLng               Float?                  @map("gps_lng")
  // Radius in metres around the stop's GPS point that counts as "at the stop".
  // A ping crossing INTO this radius creates a TripStopVisit.enteredAt event
  // (bus arrived at stop); crossing OUT sets leftAt. Null defaults to 100m
  // in the evaluator so legacy stops still work without a backfill.
  geofenceRadiusM      Int?                    @map("geofence_radius_m")
  estimatedArrivalMins Int?                    @map("estimated_arrival_mins")
  landmark             String?
  /// Phase 3b — link to spatial.places(type=STOP). The Place carries the
  /// same lat/lng + radius as gpsLat/gpsLng/geofenceRadiusM here, and is
  /// backfilled at migration time so both stay in sync. Readers still use
  /// the local columns; the Place link is available for cross-module
  /// queries (e.g. "all Places used by any route in this tenant").
  placeId              String?                 @map("place_id")
  place                Place?                  @relation("RouteStopPlace", fields: [placeId], references: [id], onDelete: SetNull)
  /// Route versioning Phase 1 — link to the specific variant version this
  /// stop belongs to. When null the stop is a "flat" pre-versioning row
  /// still readable via routeId. New stops written through the versioned
  /// writer API always stamp this.
  variantVersionId     String?                 @map("variant_version_id")
  variantVersion       BusRouteVariantVersion? @relation(fields: [variantVersionId], references: [id], onDelete: Cascade)
  route                BusRoute                @relation(fields: [routeId], references: [id])

  @@index([placeId], map: "idx_route_stops_place_id")
  @@index([variantVersionId], map: "idx_route_stops_variant_version")
  @@map("route_stops")
  @@schema("public")
}

// ── Route type dictionary (tenant-scoped) ─────────────────────────────────
//
// BusRoute.routeType was a free-form string with a hardcoded UI dropdown
// (STAFF|SCHOOL|BOTH). This table lets operators add custom types (e.g.
// "SHUTTLE", "EXECUTIVE") without a code change. Seeded with three default
// system types per-tenant on first read; `isSystem` prevents deletion of
// defaults so the code paths that assume they exist don't break.

/// Standing passenger roster on a Route (not a Trip).
///
/// The passenger registers once for a route with a pickup/drop-off stop,
/// timings, and a validity window (effective_from/effective_to). When a
/// trip is later scheduled from the route, this roster materialises into
/// TripPassenger rows for that specific trip's attendance. That expansion
/// is phase-2 wiring — the roster is the source of truth for who normally
/// rides which route.
model RoutePassenger {
  id                  String    @id @default(uuid())
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId            String    @map("tenant_id")
  routeId             String    @map("route_id")
  staffMemberId       String    @map("staff_member_id")
  pickupStopId        String?   @map("pickup_stop_id")
  pickupTime          String?   @map("pickup_time") // 'HH:MM' 24h
  dropoffStopId       String?   @map("dropoff_stop_id")
  dropoffTime         String?   @map("dropoff_time")
  effectiveFrom       DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo         DateTime? @map("effective_to") @db.Date
  status              String    @default("ACTIVE") // ACTIVE | INACTIVE
  notes               String?
  createdBy           String?   @map("created_by")
  /// Fleet routing / VRPTW — per-enrollment overrides. All 'HH:MM' 24h
  /// strings to match pickupTime / dropoffTime convention above. Nullable
  /// so the resolver falls through to BusRoute / Tenant defaults.
  earliestPickup      String?   @map("earliest_pickup") // window start override
  latestPickup        String?   @map("latest_pickup") // window end override
  requiredArrivalTime String?   @map("required_arrival_time") // hard workplace-arrival override
  pickupBufferMin     Int?      @map("pickup_buffer_min")

  route BusRoute @relation(fields: [routeId], references: [id])

  @@index([tenantId], map: "idx_route_passengers_tenant")
  @@index([routeId], map: "idx_route_passengers_route")
  @@index([staffMemberId], map: "idx_route_passengers_staff")
  @@index([deletedAt], map: "idx_route_passengers_deleted")
  @@index([status], map: "idx_route_passengers_status")
  @@map("route_passengers")
  @@schema("public")
}

/// Recurring schedule template for bus-ops. Describes the RULE
/// ("Marina MORNING SUN-THU Pickup at 07:00 from Aug 7 onwards"); the
/// generator materialises this rule into concrete TripSchedule rows for a
/// chosen date window, respecting activeDays + exceptionDates.
///
/// Kept as its own entity rather than overloading TripSchedule so the
/// "specific dated trip" semantics of TripSchedule (dispatch board, GPS,
/// incidents, roster expansion) stay unambiguous.
model BusOpsScheduleTemplate {
  id             String     @id @default(uuid())
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)
  tenantId       String     @map("tenant_id")
  name           String
  routeId        String     @map("route_id")
  vehicleId      String?    @map("vehicle_id") // default vehicle; overridable per instance
  driverId       String?    @map("driver_id")
  weekType       String     @map("week_type") // SUN_THU | MON_FRI | SAT_WED | CUSTOM
  activeDays     Int[]      @map("active_days") // 0=Sun … 6=Sat, matches JS Date.getDay()
  session        String // MORNING | EVENING | NIGHT | SPLIT
  departureTime  String     @map("departure_time") // 'HH:MM' 24h
  arrivalTime    String?    @map("arrival_time") // 'HH:MM' 24h (auto-fillable from route.duration)
  direction      String // PICKUP | DROPOFF
  effectiveFrom  DateTime   @default(now()) @map("effective_from") @db.Date
  effectiveTo    DateTime?  @map("effective_to") @db.Date
  exceptionDates DateTime[] @map("exception_dates") @db.Date
  status         String     @default("ACTIVE") // ACTIVE | INACTIVE
  notes          String?
  createdBy      String?    @map("created_by")

  @@index([tenantId], map: "idx_bus_ops_schedule_templates_tenant")
  @@index([routeId], map: "idx_bus_ops_schedule_templates_route")
  @@index([deletedAt], map: "idx_bus_ops_schedule_templates_deleted")
  @@index([status], map: "idx_bus_ops_schedule_templates_status")
  @@map("bus_ops_schedule_templates")
  @@schema("public")
}

/// TransportCalendar — per-tenant exception-day calendar. The schedule
/// template generator consults the tenant's active calendar and skips
/// HOLIDAY dates (in addition to per-template exceptionDates), and can
/// force-generate on WORKING_OVERRIDE dates. HALF_DAY and REDUCED_SERVICE
/// are informational for the UI (phase 2).
model TransportCalendar {
  id            String                   @id @default(uuid())
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?                @map("deleted_at") @db.Timestamptz(6)
  tenantId      String                   @map("tenant_id")
  name          String
  effectiveFrom DateTime                 @default(now()) @map("effective_from") @db.Date
  effectiveTo   DateTime?                @map("effective_to") @db.Date
  isActive      Boolean                  @default(true) @map("is_active")
  notes         String?
  createdBy     String?                  @map("created_by")
  entries       TransportCalendarEntry[]

  @@index([tenantId], map: "idx_transport_calendars_tenant")
  @@index([isActive], map: "idx_transport_calendars_active")
  @@index([deletedAt], map: "idx_transport_calendars_deleted")
  @@map("transport_calendars")
  @@schema("public")
}

model TransportCalendarEntry {
  id         String            @id @default(uuid())
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  calendarId String            @map("calendar_id")
  entryDate  DateTime          @map("entry_date") @db.Date
  kind       String // HOLIDAY | WORKING_OVERRIDE | HALF_DAY | REDUCED_SERVICE
  note       String?
  calendar   TransportCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, entryDate], map: "uniq_transport_calendar_entries_cal_date")
  @@index([calendarId], map: "idx_transport_calendar_entries_calendar")
  @@index([entryDate], map: "idx_transport_calendar_entries_date")
  @@map("transport_calendar_entries")
  @@schema("public")
}

model BusRouteType {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId  String   @map("tenant_id")
  name      String
  isSystem  Boolean?  @default(false) @map("is_system")

  @@unique([tenantId, name], map: "uniq_bus_route_types_tenant_name")
  @@map("bus_route_types")
  @@schema("public")
}

// ── Bus GPS ingest + geofence-driven stop visits ─────────────────────────────
//
// BusGpsPing stores raw location samples from vehicle trackers OR the driver
// mobile app. TripStopVisit is the derived state — one row per (schedule,stop)
// with three progressive timestamps set by the geofence evaluator:
//   approachedAt = ping crossed the pre-notify radius (default 800m)
//   enteredAt    = ping crossed the arrival radius (default 100m)
//   leftAt       = ping exited the arrival radius after entering
//
// The evaluator writes idempotently: re-firing the same ping (retries, gateway
// duplication) doesn't create extra visits or re-notify.

model BusGpsPing {
  id         String    @id @default(uuid())
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId   String?   @map("tenant_id")
  vehicleId  String    @map("vehicle_id")
  scheduleId String?   @map("schedule_id")
  latitude   Float
  longitude  Float
  speedKmh   Float?    @map("speed_kmh")
  headingDeg Float?    @map("heading_deg")
  accuracyM  Float?    @map("accuracy_m")
  occurredAt DateTime  @map("occurred_at") @db.Timestamptz(6)
  source     String? // 'DRIVER_APP' | 'TRACKER' | 'GATEWAY'

  @@index([scheduleId, occurredAt], map: "idx_bus_gps_pings_schedule_occurred")
  @@index([vehicleId, occurredAt], map: "idx_bus_gps_pings_vehicle_occurred")
  @@map("bus_gps_pings")
  @@schema("fleet")
}

model TripStopVisit {
  id                 String    @id @default(uuid())
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId           String   @map("tenant_id")
  scheduleId         String    @map("schedule_id")
  stopId             String    @map("stop_id")
  // Ping crossed the approach radius (default 800m). Used to gate approach
  // notifications so they fire at most once per visit.
  approachedAt       DateTime? @map("approached_at") @db.Timestamptz(6)
  // Ping crossed the arrival radius (default 100m). "Bus at stop".
  enteredAt          DateTime? @map("entered_at") @db.Timestamptz(6)
  // Ping exited the arrival radius after entering.
  leftAt             DateTime? @map("left_at") @db.Timestamptz(6)
  // Whether the approach notification was successfully queued (best-effort).
  approachNotifiedAt DateTime? @map("approach_notified_at") @db.Timestamptz(6)

  @@unique([scheduleId, stopId], map: "uniq_trip_stop_visit")
  @@map("trip_stop_visits")
  @@schema("public")
}

model TripSchedule {
  id                    String                  @id @default(uuid())
  createdAt             DateTime?               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime?               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?               @map("deleted_at") @db.Timestamptz(6)
  /// Tenant scope — column was created by the legacy tenant_isolation.sql
  /// ops script; declared here so the Prisma client exposes `tenantId` and
  /// future migrations track it. Nullable until `phase0_backfill_safety.sql`
  /// is run on the target environment.
  tenantId              String                 @map("tenant_id")
  tripNumber            String?                 @map("trip_number")
  // Back-reference to the recurring template this instance was generated
  // from (null = ad-hoc one-off trip created directly, not from a template).
  templateId            String?                 @map("template_id")
  routeId               String                  @map("route_id")
  vehicleId             String?                 @map("vehicle_id")
  driverId              String?                 @map("driver_id")
  departureTime         DateTime                @map("departure_time") @db.Timestamptz(6)
  arrivalTime           DateTime?               @map("arrival_time") @db.Timestamptz(6)
  /// Hard "must-arrive-by" deadline used by MERGED_ARRIVAL_SLA in the
  /// Planning Constraint Engine. `arrivalTime` is an estimate; this is
  /// the commitment. Nullable — trips without a stated SLA are treated
  /// as unconstrained.
  latestArrivalTime     DateTime?               @map("latest_arrival_time") @db.Timestamptz(6)
  frequency             String?                 @default("DAILY") // DAILY|WEEKLY|ONCE
  shiftType             String?                 @map("shift_type") // MORNING|EVENING|NIGHT|SPLIT
  direction             String?                 @default("INBOUND") // INBOUND|OUTBOUND
  capacity              Int?                    @default(30)
  confirmedCount        Int?                    @default(0) @map("confirmed_count")
  status                String?                 @default("SCHEDULED") // SCHEDULED|DEPARTED|IN_TRANSIT|COMPLETED|CANCELLED|MERGED
  /// Merge lineage — set on source trips when they get merged into a
  /// new consolidated trip. Points at the merged trip's id. Nullable
  /// on the common (unmerged) case. Self-relation kept as a plain FK
  /// column here; the Prisma-level self-relation is deliberately not
  /// declared to avoid churning include/select shapes across the app.
  mergedIntoTripId      String?                 @map("merged_into_trip_id")
  // ── Headway support ──────────────────────────────────────────────────
  // 'TIMEPOINT' (default): the row IS a single timed trip.
  // 'HEADWAY':            the row is a headway template — actual trips are
  //                       expanded from HeadwayRule rows at view time.
  schedulingMode        String?                 @default("TIMEPOINT") @map("scheduling_mode") // TIMEPOINT|HEADWAY
  notes                 String?
  /// Route versioning Phase 1 — snapshot of the specific variant version
  /// this trip runs. Historical reads should prefer this over `routeId`
  /// so a route edit made after the trip completed can't corrupt
  /// what-actually-happened.
  routeVariantVersionId String?                 @map("route_variant_version_id")
  routeVariantVersion   BusRouteVariantVersion? @relation(fields: [routeVariantVersionId], references: [id], onDelete: SetNull)
  route                 BusRoute                @relation(fields: [routeId], references: [id])
  passengers            TripPassenger[]
  tripLogs              TripLog[]
  headwayRules          HeadwayRule[]

  @@index([routeVariantVersionId], map: "idx_trip_schedules_variant_version")
  @@map("trip_schedules")
  @@schema("public")
  @@unique([tenantId, tripNumber])
}

// ── Headway rules (per route + direction) ──────────────────────────────────
//
// Each rule defines a time window during which trips depart on a fixed
// interval. The page / bus-stops UI expands the rules into concrete
// "next bus" calculations without persisting each trip. The Planning
// Core can use the rules as a build target for batch expansion.

model HeadwayRule {
  id             String    @id @default(uuid())
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at")
  tenantId       String   @map("tenant_id")
  routeId        String    @map("route_id")
  // Optional link to a trip_schedules row when the rule was authored from
  // a specific scheduled trip (lets the UI round-trip without losing the
  // parent context). Null for rules authored from the Headway page.
  tripId         String?   @map("trip_id")
  // Day-of-week mask: 7-char string of 'Y' (active) and 'N' (off) starting
  // Sunday. 'YYYYYYY' = every day. Lets one route have different headways
  // on weekdays vs weekends.
  dayMask        String    @default("YYYYYYY") @map("day_mask")
  // Local-time-of-day, stored as 'HH:MM' for clarity in the DB.
  // Time-window semantics are "headway applies from startTime to endTime,
  // local time". Cross-midnight windows (e.g. 23:00 -> 02:00) are split
  // into two rules by the headway service.
  startTime      String    @map("start_time") // 'HH:MM'
  endTime        String    @map("end_time") // 'HH:MM'
  // Gap between consecutive departures in this window, in minutes.
  headwayMinutes Int       @map("headway_minutes")
  // Optional anchor — if set, departures align to this HH:MM beat (e.g.
  // 0, 10, 20, 30 min past the hour). The headway service snaps the
  // first departure to the nearest anchor before stepping by headwayMinutes.
  anchorTime     String?   @map("anchor_time")
  // CBA rule-set binding — see CbaRuleSet below. When set, the planning
  // engine must respect this rule-set's max work hours / OT threshold
  // when computing the run/blocks for trips expanded from this rule.
  cbaRuleSetId   String?   @map("cba_rule_set_id")
  notes          String?

  trip       TripSchedule? @relation(fields: [tripId], references: [id])
  cbaRuleSet CbaRuleSet?   @relation(fields: [cbaRuleSetId], references: [id])
  route      BusRoute      @relation(fields: [routeId], references: [id])

  @@index([tenantId, routeId])
  @@index([tenantId, cbaRuleSetId])
  @@map("headway_rules")
  @@schema("public")
}

// ── CBA / union rule sets ──────────────────────────────────────────────────
//
// A rule-set is a named bundle of labour rules (max work hours, OT
// threshold, min rest, day-off rules, etc.) that a tenant can apply to
// specific routes, headway rules, or staffing categories. The Planning
// Core (runcut / block / roster) reads the rule-set via the headway
// binding or a per-route override and uses the numbers as the runcut
// work-rules defaults.
//
// Rules are stored as JSONB so the schema can evolve with the rule
// taxonomy (e.g. spread-pay rules, split-shift rules, holiday rules)
// without a migration each time.

model CbaRuleSet {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at")
  tenantId  String   @map("tenant_id")

  // Display name — e.g. "UAE Federal Labour Law 2024", "DPC 2024 CBA",
  // "Weekend Only".
  name         String
  // Optional description / source citation.
  description  String?
  // Country / jurisdiction (e.g. "AE", "SA", "IN"). Used for grouping
  // in the UI and to suggest a default rule-set for new routes.
  jurisdiction String?
  // Whether this is the default rule-set for the tenant. The planning
  // engine falls back to the default when no explicit binding is set.
  isDefault    Boolean? @default(false) @map("is_default")
  // Whether this is a system-provided rule-set (not editable by the
  // tenant admin). Mirrors the isSystem flag on Role.
  isSystem     Boolean? @default(false) @map("is_system")

  // Rule payload — see lib/cba/types.ts for the shape. Versioned so
  // tenants can pin a specific rule-set while we evolve the schema.
  rulesJson     Json @map("rules")
  schemaVersion Int  @default(1) @map("schema_version")

  headwayRules HeadwayRule[]

  @@index([tenantId])
  @@map("cba_rule_sets")
  @@schema("public")
}

