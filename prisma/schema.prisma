// ── Web Push subscriptions (Staff Transport mobile PWA) ─────────────────────
//
// Each row is one device/browser the staff member has used to subscribe to
// push notifications. The `endpoint` is the unique URL the push service
// gives the browser; p256dh + auth are the encryption keys for the payload.
// We keep a soft delete (`revokedAt`) so we can disable a single device
// without losing the history.
model PushSubscription {
  id                String    @id @default(uuid())
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  tenantId          String   @map("tenant_id")
  staffMemberId     String    @map("staff_member_id")
  endpoint          String    @unique
  p256dh            String
  auth              String
  userAgent         String?   @map("user_agent")
  // Reminder opt-ins (so the user can mute "Boarding call" but keep
  // "Running late" alerts). Default to all on.
  optInTripReminder Boolean?  @default(true) @map("opt_in_trip_reminder")
  optInRunningLate  Boolean?  @default(true) @map("opt_in_running_late")
  optInDelay        Boolean?  @default(true) @map("opt_in_delay")
  lastSentAt        DateTime? @map("last_sent_at") @db.Timestamptz(6)
  lastErrorAt       DateTime? @map("last_error_at") @db.Timestamptz(6)
  lastErrorCode     Int?      @map("last_error_code")

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([tenantId, revokedAt])
  @@index([staffMemberId, revokedAt])
  @@map("push_subscriptions")
  @@schema("public")
}

// ── Finance Source Ledger ────────────────────────────────────────────────────
//
// Central receivables ledger. Every module (leasing, rental, logistics, …)
// mirrors its outgoing invoices here so Finance has a single query surface.
// The hub-and-spoke pattern uses module_source + reference_type + reference_id
// to link back to the originating record in the source module's table.
//
// tenant_id is covered by the RLS migration
// (prisma/migrations/20260809000000_adopt_finance_tables_with_rls/).
// DO NOT recreate this table at runtime — it is migration-managed.
model FinanceInvoice {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  invoiceNumber      String    @unique @map("invoice_number")
  clientName         String    @map("client_name")
  clientEmail        String?   @map("client_email")
  clientPhone        String?   @map("client_phone")
  clientAddress      String?   @map("client_address")
  serviceType        String    @default("GENERAL") @map("service_type")
  module             String    @default("GENERAL")
  description        String?
  lineItems          Json      @default("[]") @map("line_items")
  lineItemsJson      Json?     @map("line_items_json")
  subtotal           Decimal   @default(0) @db.Decimal(14, 2)
  discountAmount     Decimal   @default(0) @map("discount_amount") @db.Decimal(14, 2)
  vatRate            Decimal   @default(5) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount          Decimal   @default(0) @map("vat_amount") @db.Decimal(14, 2)
  totalAmount        Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  paidAmount         Decimal   @default(0) @map("paid_amount") @db.Decimal(14, 2)
  currency           String    @default("AED")
  issueDate          DateTime  @default(now()) @map("issue_date") @db.Date
  dueDate            DateTime? @map("due_date") @db.Date
  paymentStatus      String    @default("DRAFT") @map("payment_status")
  notes              String?
  // Polymorphic back-link to source module record
  referenceId        String?   @map("reference_id") @db.Uuid
  referenceType      String?   @map("reference_type")
  createdBy          String?   @map("created_by")
  tenantId           String?   @map("tenant_id")
  // Structured source fields — richer than the polymorphic pair above
  moduleSource       String?   @map("module_source")
  sourceEntityType   String?   @map("source_entity_type")
  sourceEntityId     String?   @map("source_entity_id")
  sourceEntityNo     String?   @map("source_entity_no")
  sourceCustomerId   String?   @map("source_customer_id")
  sourceCustomerName String?   @map("source_customer_name")
  sourceContractIds  String[]  @map("source_contract_ids")
  sourcePayload      Json      @default("{}") @map("source_payload")

  // ── Extended columns — migration 20260810000001_finance_extended_columns ──
  // Previously added at runtime by bootstrap() / ensureTable(); now
  // migration-managed. All nullable for backward compatibility with rows
  // that predate these columns.
  branch       String? @default("Dubai") // originating branch label
  vehicleNo    String? @map("vehicle_no") // registration / plate
  contractType String? @map("contract_type") // e.g. LEASE | RENTAL | LOGISTICS

  // Branch foreign key — links to the tenant_branches record that issued the invoice.
  // Nullable: invoices created before branch management existed have no FK.
  branchId           String? @map("branch_id") @db.Uuid
  branchName         String? @map("branch_name")
  branchTradeLicense String? @map("branch_trade_license")
  branchAddress      String? @map("branch_address")

  // Relations
  tenantBranch TenantBranch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payments     FinancePayment[]
  allocations  FinancePaymentAllocation[]

  @@index([moduleSource, referenceType, referenceId], map: "idx_finance_invoices_source")
  @@index([sourceEntityType, sourceEntityId], map: "idx_finance_invoices_source_entity")
  @@index([tenantId], map: "idx_finance_invoices_tenant_id")
  @@index([branchId], map: "idx_finance_invoices_branch_id")
  @@map("finance_invoices")
  @@schema("finance")
}

// ── Finance Journal Entries (double-entry skeleton) ──────────────────────────
//
// Each journal entry is one balanced accounting event (total_debit = total_credit).
// finance_journal_lines holds the debit/credit legs.
// Logistics freight settlement writes here via postFreightSettlementToFinance.
// tenant_id is RLS-covered by the same migration as FinanceInvoice above.
model FinanceJournalEntry {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  jeNumber     String    @unique @map("je_number")
  entryDate    DateTime  @map("entry_date") @db.Date
  periodYear   Int       @map("period_year")
  periodMonth  Int       @map("period_month")
  narration    String
  reference    String?
  sourceType   String    @default("MANUAL") @map("source_type")
  sourceId     String?   @map("source_id")
  // DRAFT | APPROVED | POSTED | REVERSED
  status       String    @default("DRAFT")
  totalDebit   Decimal   @default(0) @map("total_debit") @db.Decimal(15, 2)
  totalCredit  Decimal   @default(0) @map("total_credit") @db.Decimal(15, 2)
  isBalanced   Boolean   @default(false) @map("is_balanced")
  // Reversal cross-references
  reversedJeId String?   @map("reversed_je_id")
  reversalJeId String?   @map("reversal_je_id")
  preparedBy   String?   @map("prepared_by")
  approvedBy   String?   @map("approved_by")
  postedBy     String?   @map("posted_by")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  postedAt     DateTime? @map("posted_at") @db.Timestamptz(6)
  notes        String?
  currency     String    @default("AED")
  tenantId     String?   @map("tenant_id")

  lines FinanceJournalLine[]

  @@index([tenantId, sourceType, sourceId], map: "idx_finance_journal_entries_logistics_source")
  @@index([tenantId], map: "idx_finance_journal_entries_tenant_id")
  @@map("finance_journal_entries")
  @@schema("finance")
}

// One debit or credit leg on a journal entry.
model FinanceJournalLine {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  journalEntryId String              @map("journal_entry_id") @db.Uuid
  journalEntry   FinanceJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  lineNumber    Int     @map("line_number")
  accountCode   String  @map("account_code")
  accountName   String? @map("account_name")
  description   String?
  debitAmount   Decimal @default(0) @map("debit_amount") @db.Decimal(15, 2)
  creditAmount  Decimal @default(0) @map("credit_amount") @db.Decimal(15, 2)
  // DEBIT | CREDIT — the normal balance side for the account type
  normalBalance String  @default("DEBIT") @map("normal_balance")
  costCentre    String? @map("cost_centre")
  profitCentre  String? @map("profit_centre")
  currency      String  @default("AED")

  @@map("finance_journal_lines")
  @@schema("finance")
}

// ── Finance Payments ──────────────────────────────────────────────────────────
//
// Records cash receipts against finance_invoices. Tenant-scoped via tenant_id
// (defence-in-depth) and through the FK to finance_invoices which has its own
// RLS policy. Table is managed by migration
// 20260810000001_finance_extended_columns; FORCE RLS + tenant_isolation policy
// applied there.
//
// DO NOT recreate this table at runtime.
model FinancePayment {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // FK to the invoice being paid. Nullable: a payment can be recorded
  // before it is matched to a specific invoice (unallocated cash).
  invoiceId String?         @map("invoice_id") @db.Uuid
  invoice   FinanceInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  tenantId String? @map("tenant_id")

  amount        Decimal  @db.Decimal(14, 2)
  paymentDate   DateTime @default(now()) @map("payment_date") @db.Date
  // BANK_TRANSFER | CASH | CHEQUE | CARD | DIRECT_DEBIT
  paymentMethod String   @default("BANK_TRANSFER") @map("payment_method")
  reference     String?
  notes         String?

  allocations FinancePaymentAllocation[]

  @@index([tenantId], map: "idx_finance_payments_tenant")
  @@index([invoiceId], map: "idx_finance_payments_invoice")
  @@map("finance_payments")
  @@schema("finance")
}

// ── Billing Runs ──────────────────────────────────────────────────────────────
//
// Platform-level audit record for each automated billing sweep. One row per
// run across all tenants — intentionally has NO tenant_id / NO RLS.
// Managed by migration 20260810000001_finance_extended_columns.
//
// DO NOT recreate this table at runtime.
model BillingRun {
  id              String    @id @default(uuid()) @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  runDate         DateTime  @map("run_date") @db.Date
  // RUNNING | COMPLETED | FAILED
  status          String    @default("RUNNING")
  totalTenants    Int       @default(0) @map("total_tenants")
  invoicesCreated Int       @default(0) @map("invoices_created")
  totalAmount     Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  errors          Json      @default("[]")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([runDate(sort: Desc)], map: "idx_billing_runs_run_date")
  @@map("billing_runs")
  @@schema("public")
}

// ── Tenant Branches ───────────────────────────────────────────────────────────
//
// Multi-branch support for enterprise tenants. Each branch carries its own
// trade licence and billing address, which are stamped onto finance_invoices
// at the time of creation.
//
// This table was previously created at runtime by ensureTable() in
// src/app/api/tenant-branches/route.ts. It is now migration-managed; the
// runtime CREATE TABLE IF NOT EXISTS will be removed once this model is
// deployed. A reconciliation migration (20260810000002_adopt_tenant_branches)
// must be run to formalise existing rows under Prisma ownership.
//
// DO NOT recreate this table at runtime.
model TenantBranch {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenantId              String    @map("tenant_id")
  branchName            String    @map("branch_name")
  // UAE emirate code: DUBAI | ABU_DHABI | SHARJAH | AJMAN | etc.
  emirate               String    @default("DUBAI")
  tradeLicenseNo        String?   @map("trade_license_no")
  tradeLicenseAuthority String?   @map("trade_license_authority")
  tradeLicenseExpiry    DateTime? @map("trade_license_expiry") @db.Date
  billingAddress        String?   @map("billing_address")
  billingCity           String?   @map("billing_city")
  billingPoBox          String?   @map("billing_po_box")
  contactName           String?   @map("contact_name")
  contactEmail          String?   @map("contact_email")
  contactPhone          String?   @map("contact_phone")
  costCenterCode        String?   @map("cost_center_code")
  isDefault             Boolean   @default(false) @map("is_default")
  isActive              Boolean   @default(true) @map("is_active")
  notes                 String?

  // Finance invoices issued under this branch
  invoices FinanceInvoice[]

  @@index([tenantId], map: "idx_tenant_branches_tenant")
  @@index([emirate], map: "idx_tenant_branches_emirate")
  @@map("tenant_branches")
  @@schema("public")
}

// ── Finance Profit Centres ────────────────────────────────────────────────────
//
// Master table for profit centre codes. Separate from cost_centre (operational
// dimension) — profit centres track P&L by business unit.
// Seeded with 7 standard entries by migration 20260810000006.
model FinanceProfitCentre {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  code        String   @unique
  name        String
  description String?
  parentCode  String?  @map("parent_code")
  // RENTAL | LEASING | LOGISTICS | BUS | MAINTENANCE | GENERAL
  module      String?
  isActive    Boolean  @default(true) @map("is_active")
  budget      Decimal? @db.Decimal(15, 2)
  tenantId    String?  @map("tenant_id")

  @@index([code], map: "idx_profit_centres_code")
  @@index([tenantId], map: "idx_profit_centres_tenant")
  @@map("finance_profit_centres")
  @@schema("finance")
}

// ── Finance Payables (AP sub-ledger) ─────────────────────────────────────────
//
// Records vendor invoices and other payable obligations.
// Lifecycle: DRAFT → SUBMITTED → APPROVED → POSTED
// Payment status: UNPAID → PARTIALLY_PAID → PAID (or OVERDUE | VOID)
// Source-to-finance lineage: MAINTENANCE_REQUEST | CARRIER_SETTLEMENT | VENDOR_INVOICE | MANUAL
model FinancePayable {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  payableNumber String @unique @map("payable_number")

  vendorId    String? @map("vendor_id")
  vendorName  String  @map("vendor_name")
  vendorEmail String? @map("vendor_email")
  vendorPhone String? @map("vendor_phone")

  // MAINTENANCE | LOGISTICS | LEASING | GENERAL
  module     String?
