// ── Route Consolidation Phase 2 — lineage ────────────────────────────────────
//
// Relational lineage for the Route Consolidation apply/revert flow.
// See prisma/migrations/20260816000000_route_consolidation_phase2_schema
// for the migration + full commentary. Highlights:
//
//   - RouteConsolidation                            = parent lineage row
//     RouteConsolidationSource                      = one row per source route
//     RouteConsolidationEnrollmentMigration         = one row per moved
//                                                     enrollment (XOR FK
//                                                     to RoutePassenger or
//                                                     TransportEnrollment)
//
//   - status = APPLIED | REVERTED. Preview is stateless (nothing persists);
//     FAILED can't be written inside a rolled-back apply transaction, so
//     it's not in the persisted enum.
//
//   - Hard idempotency: UNIQUE(tenantId, idempotencyKey). Partial UNIQUE
//     (tenantId, recommendationId) WHERE status='APPLIED' blocks two
//     concurrent active applies of the same rec while still permitting
//     re-apply after revert.
//
//   - Cool-down for post-consolidation merged routes is derived from
//     `appliedAt`; no dedicated column added to BusRoute.

// ─── Route Consolidation scoring policy ─────────────────────────────────────
//
// Tenant-editable weights/reference values feeding the Stage 4 scorer
// (rankingCost = impactScore - benefitScore, bounded [-1,+1], lower = better).
// Versioned by effective-dating rather than destructive edits: activating a
// new policy sets isActive=false + effectiveTo=now() on the previous active
// row instead of overwriting it, so `RouteConsolidation.objectiveSnapshot`
// (captured at apply time) always refers to a policy shape that still
// exists historically, even after weights change.
//
// distanceWeight + timeWeight + resourceReleaseWeight must sum to 1.0.
// passengerImpactWeight + detourWeight + pcePenaltyWeight must sum to 1.0.
// Enforced at the application layer (resolver / API validation), not via a
// DB CHECK — summing floats to exactly 1.0 in SQL is unreliable.
model RouteConsolidationScoringPolicy {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId  String    @map("tenant_id")

  name               String
  calculationVersion String @map("calculation_version")

  // ── Normalization references ──────────────────────────────────────────────
  distanceReferenceKm             Float @map("distance_reference_km")
  timeReferenceMinutes            Float @map("time_reference_minutes")
  passengerImpactReferenceMinutes Float @map("passenger_impact_reference_minutes")
  detourReferenceMinutes          Float @map("detour_reference_minutes")
  pcePenaltyReference             Float @map("pce_penalty_reference")

  // ── Benefit weights (sum to 1.0) ───────────────────────────────────────────
  distanceWeight        Float @map("distance_weight")
  timeWeight            Float @map("time_weight")
  resourceReleaseWeight Float @map("resource_release_weight")

  // ── Impact weights (sum to 1.0) — pcePenaltyWeight absorbs the old λ ───────
  passengerImpactWeight Float @map("passenger_impact_weight")
  detourWeight          Float @map("detour_weight")
  pcePenaltyWeight      Float @map("pce_penalty_weight")

  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  @@index([tenantId], map: "idx_rc_scoring_policy_tenant")
  @@index([tenantId, isActive], map: "idx_rc_scoring_policy_tenant_active")
  @@map("route_consolidation_scoring_policies")
