// ============================================================
// DOMAIN EVENT INFRASTRUCTURE (outbox + consumer inbox)
// ============================================================
// Created by migration 20260811000001_domain_event_outbox. These
// models back the outbox pattern: every Command writes a row to
// event_outbox atomically with its state change, and a publisher
// job (src/lib/outbox/publisher.ts) drains the queue, calling
// per-consumer handlers. event_consumer_inbox provides per-consumer
// idempotency: a consumer's processing of an event_id is recorded
// once and only once.

/// Transactional outbox. Rows are written in the same Postgres
/// transaction as the business mutation; a background publisher
/// reads them in order, dispatches to registered consumers, and
/// marks them published.
model EventOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  /// Stable per-event id. Used by consumers to dedup via
  /// event_consumer_inbox. Independent of the row id (which is
  /// a storage detail) so the same event can be re-emitted later
  /// without breaking consumer idempotency.
  eventId       String    @unique @default(uuid()) @db.Uuid
  /// e.g. 'finance.fuelExpense'. Routing key for the publisher.
  eventType     String
  /// Bump when the event payload shape changes. Consumers parse
  /// the version to know which schema to apply.
  eventVersion  String    @default("1")
  /// e.g. 'TripSchedule', 'FuelTransaction'. The aggregate that
  /// emitted the event.
  aggregateType String
  aggregateId   String
  /// e.g. 'bus-ops', 'finance'. Module that owns the aggregate.
  sourceModule  String
  tenantId      String    @db.Uuid
  correlationId String?   @db.Uuid
  causationId   String?   @db.Uuid
  actor         String? // userId or 'system'
  /// Event-specific data. Typed by the consumer based on eventType
  /// + eventVersion (typically via Zod).
  payload       Json
  occurredAt    DateTime  @default(now()) @db.Timestamptz(6)
  /// Set by the publisher on successful dispatch.
  publishedAt   DateTime? @db.Timestamptz(6)
  /// Set by the publisher on consumer failure. Cleared on next retry.
  failedAt      DateTime? @db.Timestamptz(6)
  failureReason String?
  /// Times we've tried and failed. Stops being retried when
  /// retryCount >= maxRetries (publisher config).
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([createdAt], map: "idx_event_outbox_unpublished")
  @@index([tenantId, eventType], map: "idx_event_outbox_tenant")
  @@index([aggregateType, aggregateId], map: "idx_event_outbox_aggregate")
  @@map("event_outbox")
  @@schema("public")
}

/// Per-consumer idempotency guard. A consumer's processing of an
/// event_id is recorded here exactly once. The publisher checks
/// this table before invoking a consumer handler; if the row
/// exists, the event is treated as already-processed and the
/// outbox row is marked published.
model EventConsumerInbox {
  id           String   @id @default(uuid()) @db.Uuid
  /// Stable consumer name. Multiple consumers can process the
  /// same event (e.g. 'finance-fuel-expense' and
  /// 'analytics-fuel') — each gets its own row.
  consumerName String
  eventId      String   @db.Uuid
  eventType    String
  tenantId     String   @db.Uuid
  /// PROCESSED | FAILED | SKIPPED. The publisher only consults
  /// the existence of the row; status is for human inspection.
  status       String   @default("PROCESSED")
  processedAt  DateTime @default(now()) @db.Timestamptz(6)
  errorMessage String?

  @@unique([consumerName, eventId], map: "uq_consumer_event")
  @@index([eventId], map: "idx_consumer_inbox_event")
  @@index([consumerName, tenantId, processedAt], map: "idx_consumer_inbox_consumer_tenant")
  @@map("event_consumer_inbox")
  @@schema("public")
}

