// The `BusOpsGeofence` model + `public.bus_ops_geofences` table were
// removed in Phase 3a of the shared-geospatial capability. Data moved
// to `spatial.places` in Phase 1 (id-preserving backfill), and the
// /api/bus-ops/geofences endpoint switched storage in Phase 2a. See
// docs/FOLLOWUP_SHARED_GEOSPATIAL_PHASES_2_3.md for the migration
// history and prisma/raw/drop_bus_ops_geofences.sql for the DDL.

// ============================================================
// SHARED GEOSPATIAL — spatial.places
// ============================================================
//
// Cross-module geospatial primitive. Every named piece of geometry the
// platform cares about — stops, geofences, depots, garages, warehouses,
// operational zones — is a row in this one table with a discriminator
// (`type`) and a shape (POINT / CIRCLE / POLYGON).
//
// Why one table instead of per-type tables:
//   - Every existing module (bus-ops, logistics, school-bus, ambulance,
//     assets) grows its own geofence/stop store otherwise. Unifying kills
//     the "every module invents places" pattern.
//   - Reference from anywhere: RouteStop.placeId, TripSchedule origin/dest,
//     Vehicle.homeDepotId — all point at the same table with the same
//     tenant scoping and RLS.
//   - Cross-module search is one query (`SELECT ... WHERE type IN (…)`)
//     instead of a UNION across bus_ops_geofences + logistics_stops + …
//
// Phase 1 (this commit) ships the model + `spatial.places` table + backfill
// from bus_ops_geofences. Consumers still write to the legacy tables —
// Phase 2 cuts each reader over one module at a time.

model Place {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId  String    @map("tenant_id")

  name        String
  /// Short optional code for human cross-reference (e.g. "GAR-DUB-01").
  code        String?
  type        String // PlaceType enum values (kept as text so a new type doesn't need a migration)
  shape       String // POINT | CIRCLE | POLYGON
  description String?
  address     String?

  centerLat Float? @map("center_lat")
  centerLng Float? @map("center_lng")
  /// Circle radius in metres. Only meaningful when shape=CIRCLE.
  radiusM   Int?   @map("radius_m")
  /// Polygon vertices as JSON [{lat, lng}, ...]. Only meaningful when shape=POLYGON.
  polygon   Json?

  /// Per-type extras — e.g. capacity for a depot, opening hours for a
  /// warehouse, parent route for a stop. Free-form so each consumer can
  /// stash what it needs without a schema change.
  metadata Json?

  /// Optional soft link to the source row that seeded this Place during
  /// backfill. Lets us reconcile if a legacy row is edited before Phase 2.
  sourceModule String? @map("source_module") // 'bus-ops' | 'logistics' | 'school-bus' | ...
  sourceId     String? @map("source_id")

  active    Boolean @default(true)
  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  // Back-relations from cross-schema consumers (Phase 3b). Named so Prisma
  // can distinguish multiple relations to Place from different call-sites.
  garages         Garage[]    @relation("GaragePlace")
  routeStops      RouteStop[] @relation("RouteStopPlace")
  vehiclesHomedAt Vehicle[]   @relation("VehicleHomeDepot")
  vehiclesInZone  Vehicle[]   @relation("VehicleZone")
  routesInZone    BusRoute[]  @relation("RouteZone")

  @@index([tenantId], map: "idx_places_tenant_id")
  @@index([tenantId, type], map: "idx_places_tenant_type")
  @@index([deletedAt], map: "idx_places_deleted_at")
  @@index([sourceModule, sourceId], map: "idx_places_source")
  @@map("places")
  @@schema("spatial")
}

