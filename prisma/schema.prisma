  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  dnNumber String @unique @map("dn_number")

  // AP-side: debit note against a vendor payable
  originalPayableId String? @map("original_payable_id")
  originalPayableNo String? @map("original_payable_no")
  // AR-side: debit note against a customer invoice
  originalInvoiceId String? @map("original_invoice_id")
  originalInvoiceNo String? @map("original_invoice_no")

  // Counterparty name (vendor for AP-side, customer for AR-side)
  vendorName  String  @map("vendor_name")
  vendorEmail String? @map("vendor_email")

  module String?

  // PRICE_CORRECTION | RETURN_OF_GOODS | SERVICE_SHORTFALL | OVERCHARGE | UNDERBILLING | OTHER
  reasonCode   String  @map("reason_code")
