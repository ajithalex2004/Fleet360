  // Period bounds — the canonical periodFrom/periodTo plus periodStart/
  // periodEnd aliases. Pre-2.7 route code referenced periodStart/periodEnd
  // and a richer set of total/output/input/net fields. Restored here so
  // the VAT POST route compiles. A follow-up migration reconciles any
  // data in the old column names; for fresh DBs the alias fields are
  // populated directly.
  periodFrom     DateTime  @map("period_from") @db.Timestamptz(6)
  periodTo       DateTime  @map("period_to") @db.Timestamptz(6)
  periodStart    DateTime? @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime? @map("period_end") @db.Timestamptz(6)
  totalSales     Decimal?  @map("total_sales") @db.Decimal
  totalPurchases Decimal?  @map("total_purchases") @db.Decimal
  totalVatOutput Decimal?  @map("total_vat_output") @db.Decimal
  totalVatInput  Decimal?  @map("total_vat_input") @db.Decimal
  outputTax      Decimal?  @map("output_tax") @db.Decimal
  inputTax       Decimal?  @map("input_tax") @db.Decimal
  netTax         Decimal?  @map("net_tax") @db.Decimal
  netVatDue      Decimal?  @map("net_vat_due") @db.Decimal
  status         String?   @default("DRAFT") // DRAFT|SUBMITTED|PAID
  filedAt        DateTime? @map("filed_at") @db.Timestamptz(6)
  submissionDate DateTime? @map("submission_date") @db.Timestamptz(6)
  paymentDate    DateTime? @map("payment_date") @db.Timestamptz(6)
  notes          String?

  @@map("vat_returns")
  @@schema("public")
  @@index([tenantId])
}

