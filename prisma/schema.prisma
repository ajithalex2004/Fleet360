model RentalCustomer {
  id               String    @id @default(uuid())
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenantId         String    @map("tenant_id")
  tenant           Tenant    @relation("RentalCustomerToTenant", fields: [tenantId], references: [id])
  fullName         String    @map("full_name")
  customerType     String?   @default("INDIVIDUAL") @map("customer_type") // INDIVIDUAL|CORPORATE|AIRLINE|INSURANCE
  nationality      String?
  passportNo       String?   @map("passport_no")
  drivingLicenseNo String?   @map("driving_license_no")
  licenseExpiry    DateTime? @map("license_expiry") @db.Timestamptz(6)
  email            String?
  phone            String?
  address          String?
  blacklisted      Boolean?  @default(false)

  // Corporate fields
  companyName      String?  @map("company_name")
  tradeLicense     String?  @map("trade_license")
  vatNumber        String?  @map("vat_number")
  creditLimit      Decimal? @map("credit_limit") @db.Decimal
  creditUsed       Decimal? @default(0) @map("credit_used") @db.Decimal
  paymentTermsDays Int?     @default(0) @map("payment_terms_days")

  // Loyalty / frequent flyer
  frequentFlyerNo String? @map("frequent_flyer_no")
  loyaltyPoints   Int?    @default(0) @map("loyalty_points")

  // Stats (denormalized for speed)
  totalRentals Int?     @default(0) @map("total_rentals")
  totalSpend   Decimal? @default(0) @map("total_spend") @db.Decimal

  bookings RentalBooking[]

  @@index([tenantId], map: "idx_rental_customers_tenant_id")
  @@index([customerType], map: "idx_rental_customers_customer_type")
  @@index([deletedAt], map: "idx_rental_customers_deleted_at")
  @@index([tenantId])
  @@map("rental_customers")
  @@schema("public")
}

model RentalBooking {
  id              String              @id @default(uuid())
  createdAt       DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)
  tenantId        String              @map("tenant_id")
  tenant          Tenant              @relation("RentalBookingToTenant", fields: [tenantId], references: [id])
  bookingRef      String?             @map("booking_ref")
  customerId      String              @map("customer_id")
  vehicleId       String?             @map("vehicle_id")
  vehicleCategory String?             @map("vehicle_category")
  pickupDate      DateTime            @map("pickup_date") @db.Timestamptz(6)
  dropoffDate     DateTime            @map("dropoff_date") @db.Timestamptz(6)
  pickupLocation  String?             @map("pickup_location")
  dropoffLocation String?             @map("dropoff_location")
  totalDays       Int?                @map("total_days")
  dailyRate       Decimal?            @map("daily_rate") @db.Decimal
  totalAmount     Decimal?            @map("total_amount") @db.Decimal
  currency        String?             @default("AED")
  status          String?             @default("PENDING") // PENDING|CONFIRMED|ACTIVE|COMPLETED|CANCELLED
  channel         String? // DIRECT|CORPORATE|AGENCY|ONLINE
  notes           String?
  customer        RentalCustomer      @relation(fields: [customerId], references: [id])
  inspections     VehicleInspection[]
  damageClaims    DamageClaim[]
  agreement       RentalAgreement?

  @@unique([tenantId, bookingRef], map: "uq_rental_bookings_tenant_ref")
  @@index([tenantId], map: "idx_rental_bookings_tenant_id")
  @@index([customerId], map: "idx_rental_bookings_customer_id")
  @@index([vehicleId], map: "idx_rental_bookings_vehicle_id")
  @@index([status], map: "idx_rental_bookings_status")
  @@index([pickupDate], map: "idx_rental_bookings_pickup_date")
  @@index([deletedAt], map: "idx_rental_bookings_deleted_at")
  @@index([tenantId])
  @@map("rental_bookings")
  @@schema("public")
}

model VehicleInspection {
