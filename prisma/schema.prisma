model RouteConsolidation {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  recommendationId String  @map("recommendation_id")
  idempotencyKey   String  @map("idempotency_key")
  mergedRouteId    String? @map("merged_route_id")
  status           String // APPLIED | REVERTED (CHECK enforced in raw SQL)

  /// JSON evidence — the objective and full recommendation snapshot at
  /// apply time. Used only for reporting / provenance; do not join to
  /// these fields for referential integrity.
  objectiveSnapshot      Json @default("{}") @map("objective_snapshot")
  recommendationSnapshot Json @default("{}") @map("recommendation_snapshot")

  /// Fingerprint of Route M + its stops + migration rows immediately
  /// after apply commits. Revert-eligibility compares this to the
  /// current fingerprint; drift blocks the revert.
  appliedStateHash String @map("applied_state_hash")

  appliedAt DateTime @map("applied_at") @db.Timestamptz(6)
  appliedBy String   @map("applied_by")

  revertedAt   DateTime? @map("reverted_at") @db.Timestamptz(6)
  revertedBy   String?   @map("reverted_by")
  revertReason String?   @map("revert_reason")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)

  sources              RouteConsolidationSource[]
  enrollmentMigrations RouteConsolidationEnrollmentMigration[]

  @@unique([tenantId, idempotencyKey], map: "uniq_route_consolidations_tenant_idem")
  @@index([tenantId, status], map: "idx_route_consolidations_tenant_status")
  @@index([tenantId, mergedRouteId], map: "idx_route_consolidations_tenant_merged_route")
  @@map("route_consolidations")
  @@schema("public")
}

model RouteConsolidationSource {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  consolidationId      String    @map("consolidation_id")
  sourceRouteId        String    @map("source_route_id")
  /// BusRoute.updatedAt snapshot at analyze time. The apply guard
  /// refuses stale applies when the source has been edited since.
  sourceRouteUpdatedAt DateTime? @map("source_route_updated_at") @db.Timestamptz(6)
  sequence             Int       @default(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  consolidation RouteConsolidation @relation(fields: [consolidationId], references: [id], onDelete: Cascade)

  @@unique([consolidationId, sourceRouteId], map: "uniq_route_consolidation_sources_pair")
  @@index([tenantId, sourceRouteId], map: "idx_route_consolidation_sources_tenant_source")
  @@index([consolidationId], map: "idx_route_consolidation_sources_consolidation")
  @@map("route_consolidation_sources")
  @@schema("public")
}

model RouteConsolidationEnrollmentMigration {
  id              String @id @default(uuid())
  tenantId        String @map("tenant_id")
  consolidationId String @map("consolidation_id")

  /// Exactly ONE of these must be set (XOR CHECK enforced in raw SQL).
  /// Two nullable FKs preserve referential integrity to both target
  /// tables without a polymorphic TEXT id.
  /// Note the type asymmetry: RoutePassenger.id is UUID in the DB
  /// (legacy migration artifact) while TransportEnrollment.id is TEXT.
  /// FK column types must match the referenced column exactly.
  routePassengerId      String? @map("route_passenger_id") @db.Uuid
  transportEnrollmentId String? @map("transport_enrollment_id")

  sourceRouteId String @map("source_route_id")
  targetRouteId String @map("target_route_id")

  oldPickupStopId  String? @map("old_pickup_stop_id")
  newPickupStopId  String? @map("new_pickup_stop_id")
  oldDropoffStopId String? @map("old_dropoff_stop_id")
  newDropoffStopId String? @map("new_dropoff_stop_id")

  /// EXACT_STOP | EXACT_PLACE_ID | OPERATOR_RESOLVED (CHECK enforced in raw SQL).
  mappingMethod String @map("mapping_method")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  consolidation RouteConsolidation @relation(fields: [consolidationId], references: [id], onDelete: Cascade)

  @@index([consolidationId], map: "idx_route_consol_enroll_mig_consolidation")
  @@index([tenantId], map: "idx_route_consol_enroll_mig_tenant")
  @@map("route_consolidation_enrollment_migrations")
  @@schema("public")
}

// ── Fleet Routing (VRPTW via Google Cloud Route Optimization) ─────────────
//
// Whole-fleet optimization models. See src/lib/planning/fleet-routing/ for
// the input builder, matrix cache, response parser, and the solve endpoint.
//
// Naming: "run" = one solve attempt; "route" = the solver's assignment of
// stops to one vehicle; "stop" = one visit on that route; "unassigned" =
// a shipment the solver couldn't fit into any route with the given constraints.

/// Cached Google Routes API computeRouteMatrix responses. Same origin/destination
/// set + same routing conditions = same matrix; reuse instead of re-billing.
/// cacheKey is sha256 over every axis that affects the returned matrix.
model FleetRouteMatrixCache {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId         String   @map("tenant_id")
  /// Deterministic hash over ALL of: originsHash, destinationsHash,
  /// routingMode, trafficBucket, routeModifiers, apiVersion.
  /// Missing any of these = silently serving stale data to the solver.
  cacheKey         String   @map("cache_key")
  originsHash      String   @map("origins_hash") // sha256 of sorted [{lat, lng}] @ 5dp
  destinationsHash String   @map("destinations_hash")
  routingMode      String   @map("routing_mode") // DRIVE | TWO_WHEELER | BICYCLE | WALK
  trafficBucket    String   @map("traffic_bucket") // off-peak | am-peak | midday | pm-peak | evening
  routeModifiers   String   @map("route_modifiers") // JSON string
  apiVersion       String   @map("api_version")
  origins          Json // decoded [{id, lat, lng}] for debugging
  destinations     Json
  matrix           Json // raw Google Routes API response
  computedAt       DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@unique([tenantId, cacheKey], map: "uniq_fleet_route_matrix_tenant_key")
  @@index([computedAt], map: "idx_fleet_route_matrix_computed")
  @@map("fleet_route_matrix_cache")
  @@schema("public")
}

/// One solve attempt against the Route Optimization API. Lifecycle:
///
///   PENDING → VALIDATING → SOLVING → SUCCESS | INFEASIBLE | FAILED | CANCELLED
///                                       ↓
///                                    PUBLISHED (SUCCESS committed to TripSchedules)
///
/// INFEASIBLE vs FAILED distinction matters for operator remediation:
///   INFEASIBLE = problem valid, no solution exists (relax constraints)
///   FAILED     = API/network/auth error (retry or fix credentials)
model FleetOptimizationRun {
  id            String                           @id @default(uuid())
  createdAt     DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId      String                           @map("tenant_id")
  createdBy     String                           @map("created_by")
  status        String // PENDING | VALIDATING | SOLVING | SUCCESS | INFEASIBLE | FAILED | CANCELLED | PUBLISHED
  statusReason  String?                          @map("status_reason") // human explanation
  targetDate    DateTime                         @map("target_date") @db.Date
  inputSnapshot Json                             @map("input_snapshot") // frozen input at solve time
  rawResponse   Json?                            @map("raw_response") // Google's raw response — traceability
  metrics       Json? // { totalDistanceKm, totalDurationMin, unassignedCount, solveSec, costEstimate }
  errorMessage  String?                          @map("error_message")
  publishedAt   DateTime?                        @map("published_at") @db.Timestamptz(6)
  publishedBy   String?                          @map("published_by")
  routes        FleetOptimizationRunRoute[]
  unassigned    FleetOptimizationRunUnassigned[]

  @@index([tenantId], map: "idx_fleet_opt_run_tenant")
  @@index([targetDate], map: "idx_fleet_opt_run_target_date")
  @@index([status], map: "idx_fleet_opt_run_status")
  @@map("fleet_optimization_runs")
  @@schema("public")
}

/// One vehicle's assignment inside a solved run. Structured (not JSON) so
/// operators can query "every route bus DXB-A-12345 was assigned to this
/// month" as SQL, not JSON traversal.
model FleetOptimizationRunRoute {
  id               String                     @id @default(uuid())
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId         String                     @map("tenant_id")
  runId            String                     @map("run_id")
  vehicleId        String                     @map("vehicle_id")
  driverId         String?                    @map("driver_id")
  sequenceInRun    Int                        @map("sequence_in_run") // 1-based
  totalDistanceKm  Float                      @map("total_distance_km")
  totalDurationMin Int                        @map("total_duration_min")
  totalPassengers  Int                        @map("total_passengers")
  encodedPolyline  String                     @map("encoded_polyline") // from Routes API computeRoutes
  startTime        DateTime                   @map("start_time") @db.Timestamptz(6)
  endTime          DateTime                   @map("end_time") @db.Timestamptz(6)
  run              FleetOptimizationRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  stops            FleetOptimizationRunStop[]

  @@index([runId], map: "idx_fleet_opt_run_route_run")
  @@index([tenantId, vehicleId], map: "idx_fleet_opt_run_route_vehicle")
  @@map("fleet_optimization_run_routes")
  @@schema("public")
}

/// One visit within a solved route. Ordered by `sequence` (1..N).
model FleetOptimizationRunStop {
  id             String                    @id @default(uuid())
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId       String                    @map("tenant_id")
  runRouteId     String                    @map("run_route_id")
  sequence       Int
  /// FK to RouteStop when the pickup matches an existing stop, null when
  /// the solver picked a fresh coord that doesn't correspond to a stored stop.
  stopId         String?                   @map("stop_id")
  lat            Float
  lng            Float
  label          String
  arrivalTime    DateTime                  @map("arrival_time") @db.Timestamptz(6)
  departureTime  DateTime                  @map("departure_time") @db.Timestamptz(6)
  passengerCount Int                       @map("passenger_count")
  /// string[] of RoutePassenger ids picked up here — Json because Prisma
  /// doesn't support String[] on this schema's provider without hassle.
  passengerIds   Json                      @map("passenger_ids")
  runRoute       FleetOptimizationRunRoute @relation(fields: [runRouteId], references: [id], onDelete: Cascade)

  @@index([runRouteId, sequence], map: "idx_fleet_opt_run_stop_route_seq")
  @@map("fleet_optimization_run_stops")
  @@schema("public")
}

/// Shipments the solver couldn't fit into any route. Surfaced to operators
/// so they know WHY (usually: capacity or window infeasibility). One row
/// per unassigned passenger.
model FleetOptimizationRunUnassigned {
  id           String               @id @default(uuid())
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId     String               @map("tenant_id")
  runId        String               @map("run_id")
  passengerId  String?              @map("passenger_id") // FK to RoutePassenger, null if solver picked a fresh coord
  stopLat      Float                @map("stop_lat")
  stopLng      Float                @map("stop_lng")
  stopLabel    String               @map("stop_label")
  /// Machine-readable reason so the UI can render targeted remediation copy.
  reason       String // NO_VEHICLE_HAS_CAPACITY | OUTSIDE_ALL_TIME_WINDOWS | CANNOT_MEET_REQUIRED_ARRIVAL | WOULD_BREAK_MAX_DRIVE_TIME | INFEASIBLE_OTHER
  reasonDetail String?              @map("reason_detail")
  run          FleetOptimizationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId], map: "idx_fleet_opt_run_unassigned_run")
  @@map("fleet_optimization_run_unassigned")
  @@schema("public")
}

