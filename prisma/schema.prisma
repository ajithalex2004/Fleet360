  email            String?
  isActive         Boolean?         @default(true) @map("is_active")
  // --- Layer 2.7 (2026-06-29) — restore relation links that Layer 2.6 ---
  // The V1 → V2 cleanup dropped the @relation directives that bound
  // LeaseContract2.openingBranchId / closingBranchId back to LeaseBranch.
