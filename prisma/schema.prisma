// ── Planning core (run/block/roster) ─────────────────────────────────────────
//
// StaffTransportPlan stores the output of the runcutting + blocking +
// rostering algorithms. The runs/blocks/rosters are kept as JSON so the
// schema doesn't need to be touched every time the algorithm evolves.
// When the plan is "applied", the run→driver mapping is written back to
// trip_schedules.driverId and the block→vehicle mapping to
// trip_schedules.vehicleId via the /apply API endpoint.

model StaffTransportPlan {
  id        String    @id @default(uuid())
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId  String   @map("tenant_id")

  // Human-readable name for the planner UI — e.g. "Scenario A — 60min deadhead"
  name        String
  // Optional description / hypothesis being tested (for the what-if UI)
  description String?

  // The time window the plan covers
  dateFrom DateTime @map("date_from") @db.Date
  dateTo   DateTime @map("date_to") @db.Date

  // Inputs: work rules + algorithm parameters. JSON to keep the schema
  // flexible — the algorithm module owns the shape.
  workRules    Json @map("work_rules")
  blockOptions Json @map("block_options")

  // Outputs: serialised Run[] and Block[]. Stored as JSONB so the
  // algorithm can evolve without migrations.
  runs    Json @map("runs")
  blocks  Json @map("blocks")
  rosters Json @default("[]") @map("rosters")
  summary Json @map("summary")

  // Lifecycle
  status    String?   @default("DRAFT") @map("status") // DRAFT|APPLIED|ARCHIVED
  appliedAt DateTime? @map("applied_at") @db.Timestamptz(6)

  // Indexes
  @@index([tenantId, dateFrom, dateTo])
  @@index([tenantId, status])
  @@map("staff_transport_plans")
  @@schema("public")
}

