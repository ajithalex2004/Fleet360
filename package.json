{
    "name": "fleet360",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "predev": "node scripts/clean-next-cache.mjs",
        "dev:turbo": "next dev --turbopack",
        "clean:dev": "node scripts/clean-dev.mjs",
        "prebuild": "node scripts/check-no-pages-dir.mjs",
        "build:driver": "cd mobile-app && node ../scripts/check-no-pages-dir.mjs --root=. && next build",
        "db:probe": "node scripts/db-probe.mjs",
        "check:migrations": "node scripts/check-destructive-migrations.js",
        "db:push": "node scripts/guard-prisma-url.js && npx prisma db push",
        "db:migrate-dev": "node scripts/guard-prisma-url.js && npx prisma migrate dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "typecheck:finance": "tsc -p tsconfig.finance.json --noEmit",
        "setup-hooks": "git config core.hooksPath scripts/githooks",
        "dev:clean": "node scripts/clean-next-dev.mjs && npm run dev",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:e2e": "playwright test",
        "test:e2e:finance": "playwright test tests/e2e/finance-workflow.spec.ts",
        "test:e2e:fleet": "playwright test tests/e2e/fleet-workflow.spec.ts",
        "test:e2e:rac": "playwright test tests/e2e/rac-workflow.spec.ts",
        "test:e2e:admin": "playwright test tests/e2e/admin-workflow.spec.ts",
        "test:e2e:cross": "playwright test tests/e2e/cross-module.spec.ts",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "smoke:marketplace": "node scripts/smoke-marketplace-live.js",
        "test:isolation:unit": "vitest run tests/unit/tenant-rls-helpers.test.ts",
        "test:isolation:integration": "vitest run tests/integration/tenant-isolation-rls.test.ts",
        "test:isolation": "npm run test:isolation:unit && npm run test:isolation:integration && npm run test:isolation:tenant001",
        "test:all": "vitest run tests/unit && vitest run tests/integration && playwright test",
        "cap:sync:ios": "npm run build:driver && npx cap sync ios",
        "cap:sync:android": "npm run build:driver && npx cap sync android",
        "cap:sync": "npm run build:driver && npx cap sync",
        "cap:open:ios": "npx cap open ios",
        "cap:open:android": "npx cap open android",
        "test:isolation:tenant001": "vitest run tests/unit/tenant-authorized-context.test.ts tests/integration/tenant-001-leasing-rental-isolation.test.ts",
        "tenant:check-auth": "node scripts/check-tenant-auth.js",
        "tenant:check-schema": "node scripts/validate-tenant-schema.js",
        "tenant:check-rls": "node scripts/check-tenant-rls.js",
        "tenant:audit": "npm run tenant:check-auth && npm run tenant:check-schema && npm run tenant:check-rls"
    },
    "dependencies": {
        "@capacitor-community/sqlite": "^6.0.2",
        "@capacitor/app": "^6.0.3",
        "@capacitor/camera": "^6.1.3",
        "@capacitor/core": "^6.2.1",
        "@capacitor/filesystem": "^6.0.4",
        "@capacitor/geolocation": "^6.1.1",
        "@capacitor/haptics": "^6.0.3",
        "@capacitor/keyboard": "^6.0.4",
        "@capacitor/network": "^6.0.4",
        "@capacitor/preferences": "^6.0.4",
        "@capacitor/share": "^6.0.4",
        "@capacitor/splash-screen": "^6.0.4",
        "@capacitor/status-bar": "^6.0.3",
        "@crayonai/react-core": "^0.7.6",
        "@crayonai/react-ui": "^0.8.31",
        "@crayonai/stream": "^0.6.4",
        "@fontsource/inter": "^5.2.8",
        "@fontsource/noto-sans-arabic": "^5.2.10",
        "@neondatabase/serverless": "^1.1.0",
        "@prisma/adapter-neon": "^5.22.0",
        "@radix-ui/react-dialog": "^1.1.15",
        "@react-pdf/renderer": "^4.5.1",
        "@simplewebauthn/browser": "^10.0.0",
        "@simplewebauthn/server": "^10.0.1",
        "@thesysai/genui-sdk": "^0.6.34",
        "@types/nodemailer": "^7.0.4",
        "@types/papaparse": "^5.5.2",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.18.1",
        "@upstash/ratelimit": "^2.0.8",
        "@upstash/redis": "^1.38.2",
        "eventsource-parser": "^3.0.6",
        "idb": "^8.0.3",
        "next": "15.2.4",
        "nodemailer": "^7.0.11",
        "openai": "^4.91.1",
        "openid-client": "^6.8.4",
        "papaparse": "^5.5.3",
        "qrcode": "^1.5.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "server-only": "^0.0.1",
        "stripe": "^22.1.1",
        "uuid": "^13.0.0",
        "web-push": "^3.6.7",
        "ws": "^8.21.1",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
        "zod": "^4.1.13",
        "zod-to-json-schema": "^3.25.0",
        "zustand": "^5.0.8"
    },
    "optionalDependencies": {
        "ioredis": "^5.4.1"
    },
    "devDependencies": {
        "@capacitor/android": "^6.2.1",
        "@capacitor/cli": "^6.2.1",
        "@capacitor/ios": "^6.2.1",
        "@eslint/eslintrc": "^3",
        "@playwright/test": "^1.59.1",
        "@prisma/client": "^5.22.0",
        "@tailwindcss/oxide": "^4.1.3",
        "@tailwindcss/postcss": "^4",
        "@types/cookie": "^0.6.0",
        "@types/geojson": "^7946.0.16",
        "@types/mapbox-gl": "^3.4.1",
        "@types/node": "^20",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/web-push": "^3.6.4",
        "@vitest/coverage-v8": "^1.6.0",
        "better-sqlite3": "^13.0.3",
        "dotenv": "^17.2.3",
        "eslint": "^9",
        "eslint-config-next": "15.2.4",
        "lightningcss": "^1.29.2",
        "prisma": "^5.22.0",
        "tailwindcss": "^4",
        "ts-node": "^10.9.2",
        "typescript": "^5",
        "vitest": "^1.6.0"
    },
    "engines": {
        "node": ">=20.9.0"
    },
    "prisma": {
        "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
    }
}
